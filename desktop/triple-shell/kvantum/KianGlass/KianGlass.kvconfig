# ==============================================================================
# KIAN-OS v3 Kvantum Theme Engine: KianGlass (Glassmorphic Dark Crystal)
# Path: desktop/triple-shell/kvantum/KianGlass/KianGlass.kvconfig
# Description: Advanced glassmorphic blur, contrast, and neon translucency styling.
# ==============================================================================

[%General]
author=Kian OS Desktop Team
comment=Kian Glassmorphic Dark Crystal Glass Theme with Dual-Kawase Blur
version=3.0.0
composite=true
blur_behind=true
translucent_windows=true
contrast=1.35
saturation_boost=1.20
reduce_window_opacity=28
shadow_size=16
shadow_color=#000000
no_window_pattern=true
active_tint_color=#00f0ff
inactive_tint_color=#05070a
tint_opacity=15
glass=true
dark_contrast=true

[GeneralColors]
window.color=#0a0d14
base.color=#0f131d
alt.base.color=#151b29
text.color=#e0e6f0
window.text.color=#e0e6f0
highlight.color=#00f0ff
highlight.text.color=#05070a
tooltip.text.color=#e0e6f0
tooltip.base.color=#0a0d14
link.color=#00f0ff
link.visited.color=#a855f7
progress.indicator.text.color=#05070a
inactive.window.color=#080a10
inactive.base.color=#0d1018
inactive.text.color=#808a9d
inactive.window.text.color=#808a9d
inactive.highlight.color=#1c2b3d
inactive.highlight.text.color=#808a9d
disabled.window.text.color=#4b5563
disabled.text.color=#4b5563
disabled.highlight.color=#1a2230
disabled.highlight.text.color=#4b5563

[Hacks]
transparent_dolphin_view=true
transparent_ktitle_label=true
blur_active_surface=true
blur_radius=8
blur_depth=4
force_translucent_tooltips=true
transparent_menutitle=true
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=true
tint=true
tint_color=#00f0ff
tint_opacity=12
dark_contrast=true
respect_translucency=true
fill_rubberband=true

[Animation]
glow_time=150
fade_time=120
transition_time=180

[Focus]
focus_color=#00f0ff
focus_glow=true
focus_rect=true
focus_margin=2

[Menu]
translucent=true
blur=true
opacity=78
menu_margin=6
overlap=1
separator_height=1
separator_color=#1f293d

[MenuBar]
translucent=true
alt_color=false

[ToolBar]
translucent=true
alt_color=false
separator_color=#1f293d

[TabBar]
alt_color=false
overlap=0
tab_margin=8

[Button]
bold_text=false
press_grow=1
flat=false
round_corners=8
border_color=#00f0ff
border_alpha=40

[LineEdit]
round_corners=8
border_color=#00f0ff
border_alpha=60
focus_border_color=#00f0ff

[ComboBox]
round_corners=8
press_grow=1

[ProgressBar]
round_corners=6
glow=true
glow_color=#00f0ff

[Slider]
groove_height=4
tick_size=4
round_corners=4

[ScrollBar]
slider_min_length=32
translucent_groove=true
hover_expand=true

[ItemView]
round_corners=6
alt_row_alpha=20
hover_alpha=35
selection_alpha=70

[ToolTip]
translucent=true
round_corners=8
border_color=#00f0ff
border_alpha=50
opacity=85
