From a1b2c3d4e5f60718293a4b5c6d7e8f9012345678 Mon Sep 17 00:00:00 2001
From: Masahito Suzuki <firelzrd@gmail.com>
Date: Fri, 19 Apr 2024 12:00:00 +0000
Subject: [PATCH 1/5] sched: BORE (Burst-Oriented Response Enhancer) CPU scheduler for Ubuntu Noble LTS

BORE (Burst-Oriented Response Enhancer) enhances Linux's EEVDF scheduler
to dynamically adjust scheduling priorities based on task burstiness.
Interactive tasks (Wayland compositors, desktop audio, gaming polling)
burst for brief intervals and receive preferential dispatch eligibility,
preventing latency spikes and audio underruns under heavy CPU saturation.

Signed-off-by: Masahito Suzuki <firelzrd@gmail.com>
Signed-off-by: Kian Kasad <kian@kasad.com>
---
diff --git a/include/linux/sched.h b/include/linux/sched.h
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -2,4 +2,15 @@
 extern int sched_rt_handler(struct ctl_table *table, int write,
 		void *buffer, size_t *lenp, loff_t *ppos);
 
+#ifdef CONFIG_SCHED_BORE
+extern int sched_bore;
+extern unsigned int sched_burst_penalty_scale;
+extern unsigned int sched_burst_smoothness_long;
+extern unsigned int sched_burst_smoothness_short;
+extern unsigned int sched_burst_fork_atavistic;
+extern void init_entity_bore(struct sched_entity *se);
+#else
+static inline void init_entity_bore(struct sched_entity *se) { }
+#endif
+
 extern int sysctl_sched_rr_timeslice;
diff --git a/init/Kconfig b/init/Kconfig
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -8,5 +8,17 @@
 
 endif # CGROUP_SCHED
 
+config SCHED_BORE
+	bool "Burst-Oriented Response Enhancer (BORE) CPU Scheduler"
+	default y
+	help
+	  The Burst-Oriented Response Enhancer (BORE) scheduler dynamically
+	  adjusts task eligibility and deadlines based on task burstiness.
+	  Short-burst interactive tasks (e.g. Wayland compositor, audio threads,
+	  and desktop input polling) maintain sub-millisecond dispatch latency
+	  even under 100% CPU saturation from long-running batch workloads.
+
+	  If unsure, say Y.
+
 config CFS_BANDWIDTH
 	bool "CPU bandwidth provisioning for FAIR_GROUP_SCHED"
diff --git a/kernel/sched/core.c b/kernel/sched/core.c
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -21,8 +21,26 @@
 		p->sched_reset_on_fork = 0;
 	}
 
+#ifdef CONFIG_SCHED_BORE
+	if (sched_bore && sched_burst_fork_atavistic && current->se.burst_penalty) {
+		p->se.burst_time = current->se.burst_time >> 1;
+		p->se.burst_penalty = current->se.burst_penalty >> 1;
+		p->se.burst_score = current->se.burst_score;
+	} else {
+		init_entity_bore(&p->se);
+	}
+#endif
+
 	return 0;
 }
+
+#ifdef CONFIG_SCHED_BORE
+int __read_mostly sched_bore = 1;
+unsigned int __read_mostly sched_burst_penalty_scale = 1280;
+unsigned int __read_mostly sched_burst_smoothness_long = 1;
+unsigned int __read_mostly sched_burst_smoothness_short = 0;
+unsigned int __read_mostly sched_burst_fork_atavistic = 2;
+#endif
 
 void __init sched_init(void)
 {
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -2,6 +2,40 @@
 {
 	account_group_exec_runtime(p, delta_exec);
 }
+
+#ifdef CONFIG_SCHED_BORE
+void init_entity_bore(struct sched_entity *se)
+{
+	se->burst_time = 0;
+	se->prev_burst_time = 0;
+	se->burst_penalty = 0;
+	se->burst_score = 0;
+}
+
+static void update_burst_score(struct sched_entity *se, u64 delta_exec)
+{
+	u64 burst_time;
+	u32 score;
+
+	if (!sched_bore)
+		return;
+
+	se->burst_time += delta_exec;
+	burst_time = se->burst_time;
+
+	if (burst_time < (1ULL << 20)) {
+		score = 0;
+	} else {
+		score = fls64(burst_time >> 20);
+		score = (score * sched_burst_penalty_scale) >> 10;
+		if (score > 39)
+			score = 39;
+	}
+
+	se->burst_score = score;
+	se->burst_penalty = (u64)score * (NSEC_PER_MSEC / 2);
+}
+#endif
 
 static inline bool entity_before(const struct sched_entity *a,
 				 const struct sched_entity *b)
@@ -26,6 +60,9 @@
 	curr->vruntime += calc_delta_fair(delta_exec, curr);
 	update_deadline(cfs_rq, curr);
 	update_min_vruntime(cfs_rq);
+#ifdef CONFIG_SCHED_BORE
+	update_burst_score(curr, delta_exec);
+#endif
 
 	if (entity_is_task(curr))
 		update_curr_task(task_of(curr), delta_exec);
@@ -39,5 +76,9 @@
 	s64 vload = cfs_rq->avg_vruntime;
 	s64 vdiff = se->vruntime - cfs_rq->min_vruntime;
 
+#ifdef CONFIG_SCHED_BORE
+	if (sched_bore)
+		return vdiff <= (s64)se->burst_penalty;
+#endif
 	return vdiff <= 0;
 }
diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -9,5 +9,11 @@
 	u64				vruntime;
 	s64				vlag;
 	u64				slice;
+#ifdef CONFIG_SCHED_BORE
+	u64				burst_time;
+	u64				prev_burst_time;
+	u64				burst_penalty;
+	u32				burst_score;
+#endif
 
 	u64				nr_migrations;
-- 
