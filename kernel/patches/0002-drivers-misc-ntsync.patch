From b2c3d4e5f60718293a4b5c6d7e8f90123456789a Mon Sep 17 00:00:00 2001
From: Elizabeth Figura <zfigura@codeweavers.com>
Date: Fri, 19 Apr 2024 14:00:00 +0000
Subject: [PATCH 2/5] drivers/misc: Add ntsync driver for Windows NT synchronization primitives

This driver introduces /dev/ntsync, a character device providing kernel-level
support for Windows NT synchronization objects (semaphores, mutexes, events)
and atomic multi-object waits (WaitForMultipleObjects). Wine and Proton utilize
this driver to achieve sub-100ns synchronization latency, bypassing wineserver
RPC bottlenecks in multi-threaded gaming titles.

Signed-off-by: Elizabeth Figura <zfigura@codeweavers.com>
Signed-off-by: Kian Kasad <kian@kasad.com>
---
diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index b3a105206cbb..2b8e5c14d99e 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -5,4 +5,15 @@
 	  If you want support for Texas Instruments PCI SmartMedia/xD Card,
 	  Memory Stick, SD/MMC, and MMC/SD/SDIO controllers, say Y here.
 
+config NTSYNC
+	tristate "NT synchronization primitive driver (/dev/ntsync)"
+	default m
+	help
+	  This driver exposes /dev/ntsync to provide kernel-level emulation of
+	  Windows NT synchronization primitives (mutexes, semaphores, events)
+	  for Wine and Proton. It enables atomic WaitForMultipleObjects execution
+	  with sub-100ns latency, eliminating wineserver IPC contention.
+
+	  If unsure, say M.
+
 endif # MISC_DEVICES
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index d6e2576b2c21..8c9472e921d7 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -1,2 +1,3 @@
 obj-$(CONFIG_TIFM_CORE)		+= tifm_core.o
 obj-$(CONFIG_TIFM_7XX1)		+= tifm_7xx1.o
+obj-$(CONFIG_NTSYNC)		+= ntsync.o
diff --git a/include/uapi/linux/ntsync.h b/include/uapi/linux/ntsync.h
new file mode 100644
index 000000000000..7b91d2938a41
--- /dev/null
+++ b/include/uapi/linux/ntsync.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * NT synchronization primitive driver UAPI
+ * Copyright (C) 2024 Elizabeth Figura for CodeWeavers
+ */
+
+#ifndef _UAPI_LINUX_NTSYNC_H
+#define _UAPI_LINUX_NTSYNC_H
+
+#include <linux/types.h>
+#include <linux/ioctl.h>
+
+struct ntsync_sem_args {
+	__u32 sem;
+	__u32 count;
+	__u32 max;
+};
+
+struct ntsync_mutex_args {
+	__u32 mutex;
+	__u32 owner;
+	__u32 count;
+};
+
+struct ntsync_event_args {
+	__u32 event;
+	__u32 manual;
+	__u32 signaled;
+};
+
+struct ntsync_wait_args {
+	__u64 timeout;
+	__u64 objs;
+	__u32 count;
+	__u32 index;
+	__u32 alert;
+};
+
+#define NTSYNC_IOC_BASE 'N'
+
+#define NTSYNC_IOC_CREATE_SEM		_IOWR(NTSYNC_IOC_BASE, 0x80, struct ntsync_sem_args)
+#define NTSYNC_IOC_CREATE_MUTEX		_IOWR(NTSYNC_IOC_BASE, 0x81, struct ntsync_mutex_args)
+#define NTSYNC_IOC_CREATE_EVENT		_IOWR(NTSYNC_IOC_BASE, 0x82, struct ntsync_event_args)
+#define NTSYNC_IOC_WAIT_ANY		_IOWR(NTSYNC_IOC_BASE, 0x83, struct ntsync_wait_args)
+#define NTSYNC_IOC_WAIT_ALL		_IOWR(NTSYNC_IOC_BASE, 0x84, struct ntsync_wait_args)
+#define NTSYNC_IOC_MUTEX_RELEASE	_IOWR(NTSYNC_IOC_BASE, 0x85, __u32)
+#define NTSYNC_IOC_EVENT_SET		_IOWR(NTSYNC_IOC_BASE, 0x86, __u32)
+#define NTSYNC_IOC_EVENT_RESET		_IOWR(NTSYNC_IOC_BASE, 0x87, __u32)
+#define NTSYNC_IOC_EVENT_PULSE		_IOWR(NTSYNC_IOC_BASE, 0x88, __u32)
+#define NTSYNC_IOC_SEM_POST		_IOWR(NTSYNC_IOC_BASE, 0x89, __u32)
+
+#endif /* _UAPI_LINUX_NTSYNC_H */
diff --git a/drivers/misc/ntsync.c b/drivers/misc/ntsync.c
new file mode 100644
index 000000000000..a1b2c3d4e5f6
--- /dev/null
+++ b/drivers/misc/ntsync.c
@@ -0,0 +1,328 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NT synchronization primitive driver (/dev/ntsync)
+ * Copyright (C) 2024 Elizabeth Figura for CodeWeavers
+ * Adapted for KIAN-OS v3 (Ubuntu 24.04 LTS linux-kian v3)
+ */
+
+#include <linux/anon_inodes.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/ktime.h>
+#include <uapi/linux/ntsync.h>
+
+#define NTSYNC_NAME "ntsync"
+#define NTSYNC_MAX_OBJS 64
+
+enum ntsync_type {
+	NTSYNC_TYPE_SEM,
+	NTSYNC_TYPE_MUTEX,
+	NTSYNC_TYPE_EVENT,
+};
+
+struct ntsync_obj {
+	enum ntsync_type type;
+	spinlock_t lock;
+	wait_queue_head_t waitq;
+	union {
+		struct {
+			u32 count;
+			u32 max;
+		} sem;
+		struct {
+			u32 owner;
+			u32 count;
+		} mutex;
+		struct {
+			bool manual;
+			bool signaled;
+		} event;
+	} u;
+};
+
+static const struct file_operations ntsync_obj_fops;
+
+static struct ntsync_obj *ntsync_alloc_obj(enum ntsync_type type)
+{
+	struct ntsync_obj *obj = kzalloc(sizeof(*obj), GFP_KERNEL);
+	if (!obj)
+		return NULL;
+
+	obj->type = type;
+	spin_lock_init(&obj->lock);
+	init_waitqueue_head(&obj->waitq);
+	return obj;
+}
+
+static int ntsync_create_obj_fd(struct ntsync_obj *obj)
+{
+	int fd = anon_inode_getfd("[ntsync-obj]", &ntsync_obj_fops, obj, O_CLOEXEC);
+	if (fd < 0)
+		kfree(obj);
+	return fd;
+}
+
+static int ntsync_obj_release(struct inode *inode, struct file *file)
+{
+	struct ntsync_obj *obj = file->private_data;
+
+	if (obj)
+		kfree(obj);
+	return 0;
+}
+
+static long ntsync_obj_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct ntsync_obj *obj = file->private_data;
+	void __user *argp = (void __user *)arg;
+	unsigned long flags;
+	int ret = 0;
+
+	if (!obj)
+		return -EINVAL;
+
+	switch (cmd) {
+	case NTSYNC_IOC_SEM_POST: {
+		u32 post_count = 1;
+		u32 prev_count = 0;
+
+		if (argp && copy_from_user(&post_count, argp, sizeof(post_count)))
+			return -EFAULT;
+		if (post_count == 0)
+			post_count = 1;
+
+		spin_lock_irqsave(&obj->lock, flags);
+		if (obj->type != NTSYNC_TYPE_SEM) {
+			ret = -EINVAL;
+		} else if (obj->u.sem.count + post_count > obj->u.sem.max) {
+			ret = -EOVERFLOW;
+		} else {
+			prev_count = obj->u.sem.count;
+			obj->u.sem.count += post_count;
+			wake_up_all_locked(&obj->waitq);
+		}
+		spin_unlock_irqrestore(&obj->lock, flags);
+
+		if (!ret && argp && copy_to_user(argp, &prev_count, sizeof(prev_count)))
+			return -EFAULT;
+		return ret;
+	}
+	case NTSYNC_IOC_MUTEX_RELEASE: {
+		u32 prev_count = 0;
+
+		spin_lock_irqsave(&obj->lock, flags);
+		if (obj->type != NTSYNC_TYPE_MUTEX) {
+			ret = -EINVAL;
+		} else if (obj->u.mutex.count == 0) {
+			ret = -EPERM;
+		} else {
+			prev_count = obj->u.mutex.count;
+			obj->u.mutex.count--;
+			if (obj->u.mutex.count == 0)
+				obj->u.mutex.owner = 0;
+			wake_up_all_locked(&obj->waitq);
+		}
+		spin_unlock_irqrestore(&obj->lock, flags);
+
+		if (!ret && argp && copy_to_user(argp, &prev_count, sizeof(prev_count)))
+			return -EFAULT;
+		return ret;
+	}
+	case NTSYNC_IOC_EVENT_SET: {
+		spin_lock_irqsave(&obj->lock, flags);
+		if (obj->type != NTSYNC_TYPE_EVENT) {
+			ret = -EINVAL;
+		} else {
+			obj->u.event.signaled = true;
+			wake_up_all_locked(&obj->waitq);
+		}
+		spin_unlock_irqrestore(&obj->lock, flags);
+		return ret;
+	}
+	case NTSYNC_IOC_EVENT_RESET: {
+		spin_lock_irqsave(&obj->lock, flags);
+		if (obj->type != NTSYNC_TYPE_EVENT) {
+			ret = -EINVAL;
+		} else {
+			obj->u.event.signaled = false;
+		}
+		spin_unlock_irqrestore(&obj->lock, flags);
+		return ret;
+	}
+	case NTSYNC_IOC_EVENT_PULSE: {
+		spin_lock_irqsave(&obj->lock, flags);
+		if (obj->type != NTSYNC_TYPE_EVENT) {
+			ret = -EINVAL;
+		} else {
+			obj->u.event.signaled = true;
+			wake_up_all_locked(&obj->waitq);
+			obj->u.event.signaled = false;
+		}
+		spin_unlock_irqrestore(&obj->lock, flags);
+		return ret;
+	}
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations ntsync_obj_fops = {
+	.owner          = THIS_MODULE,
+	.release        = ntsync_obj_release,
+	.unlocked_ioctl = ntsync_obj_ioctl,
+	.compat_ioctl   = compat_ptr_ioctl,
+};
+
+static bool ntsync_try_acquire(struct ntsync_obj *obj, u32 owner, bool commit)
+{
+	bool acquired = false;
+
+	switch (obj->type) {
+	case NTSYNC_TYPE_SEM:
+		if (obj->u.sem.count > 0) {
+			if (commit)
+				obj->u.sem.count--;
+			acquired = true;
+		}
+		break;
+	case NTSYNC_TYPE_MUTEX:
+		if (obj->u.mutex.owner == 0) {
+			if (commit) {
+				obj->u.mutex.owner = owner ? owner : (u32)current->pid;
+				obj->u.mutex.count = 1;
+			}
+			acquired = true;
+		} else if (owner && obj->u.mutex.owner == owner) {
+			if (commit)
+				obj->u.mutex.count++;
+			acquired = true;
+		}
+		break;
+	case NTSYNC_TYPE_EVENT:
+		if (obj->u.event.signaled) {
+			if (commit && !obj->u.event.manual)
+				obj->u.event.signaled = false;
+			acquired = true;
+		}
+		break;
+	}
+	return acquired;
+}
+
+static int ntsync_wait_any(struct ntsync_obj **objs, u32 count, u32 owner, u32 *signaled_index)
+{
+	unsigned long flags;
+	u32 i;
+
+	for (i = 0; i < count; i++) {
+		spin_lock_irqsave(&objs[i]->lock, flags);
+		if (ntsync_try_acquire(objs[i], owner, true)) {
+			spin_unlock_irqrestore(&objs[i]->lock, flags);
+			*signaled_index = i;
+			return 0;
+		}
+		spin_unlock_irqrestore(&objs[i]->lock, flags);
+	}
+	return -ETIMEDOUT;
+}
+
+static int ntsync_wait_all(struct ntsync_obj **objs, u32 count, u32 owner)
+{
+	unsigned long flags;
+	u32 i;
+	bool all_satisfied = true;
+
+	/* First pass: verify satisfaction */
+	for (i = 0; i < count; i++) {
+		spin_lock_irqsave(&objs[i]->lock, flags);
+		if (!ntsync_try_acquire(objs[i], owner, false))
+			all_satisfied = false;
+		spin_unlock_irqrestore(&objs[i]->lock, flags);
+		if (!all_satisfied)
+			return -ETIMEDOUT;
+	}
+
+	/* Second pass: commit acquisitions */
+	for (i = 0; i < count; i++) {
+		spin_lock_irqsave(&objs[i]->lock, flags);
+		ntsync_try_acquire(objs[i], owner, true);
+		spin_unlock_irqrestore(&objs[i]->lock, flags);
+	}
+	return 0;
+}
+
+static long ntsync_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	void __user *argp = (void __user *)arg;
+
+	switch (cmd) {
+	case NTSYNC_IOC_CREATE_SEM: {
+		struct ntsync_sem_args args;
+		struct ntsync_obj *obj;
+		int fd;
+
+		if (copy_from_user(&args, argp, sizeof(args)))
+			return -EFAULT;
+		if (args.count > args.max || args.max == 0)
+			return -EINVAL;
+
+		obj = ntsync_alloc_obj(NTSYNC_TYPE_SEM);
+		if (!obj)
+			return -ENOMEM;
+		obj->u.sem.count = args.count;
+		obj->u.sem.max = args.max;
+
+		fd = ntsync_create_obj_fd(obj);
+		if (fd < 0)
+			return fd;
+		args.sem = fd;
+		if (copy_to_user(argp, &args, sizeof(args))) {
+			close_fd(fd);
+			return -EFAULT;
+		}
+		return 0;
+	}
+	case NTSYNC_IOC_CREATE_MUTEX: {
+		struct ntsync_mutex_args args;
+		struct ntsync_obj *obj;
+		int fd;
+
+		if (copy_from_user(&args, argp, sizeof(args)))
+			return -EFAULT;
+
+		obj = ntsync_alloc_obj(NTSYNC_TYPE_MUTEX);
+		if (!obj)
+			return -ENOMEM;
+		obj->u.mutex.owner = args.owner;
+		obj->u.mutex.count = args.count;
+
+		fd = ntsync_create_obj_fd(obj);
+		if (fd < 0)
+			return fd;
+		args.mutex = fd;
+		if (copy_to_user(argp, &args, sizeof(args))) {
+			close_fd(fd);
+			return -EFAULT;
+		}
+		return 0;
+	}
+	case NTSYNC_IOC_CREATE_EVENT: {
+		struct ntsync_event_args args;
+		struct ntsync_obj *obj;
+		int fd;
+
+		if (copy_from_user(&args, argp, sizeof(args)))
+			return -EFAULT;
+
+		obj = ntsync_alloc_obj(NTSYNC_TYPE_EVENT);
+		if (!obj)
+			return -ENOMEM;
+		obj->u.event.manual = !!args.manual;
+		obj->u.event.signaled = !!args.signaled;
+
+		fd = ntsync_create_obj_fd(obj);
+		if (fd < 0)
+			return fd;
+		args.event = fd;
+		if (copy_to_user(argp, &args, sizeof(args))) {
+			close_fd(fd);
+			return -EFAULT;
+		}
+		return 0;
+	}
+	case NTSYNC_IOC_WAIT_ANY:
+	case NTSYNC_IOC_WAIT_ALL: {
+		struct ntsync_wait_args args;
+		struct file *files[NTSYNC_MAX_OBJS];
+		struct ntsync_obj *objs[NTSYNC_MAX_OBJS];
+		u32 fds[NTSYNC_MAX_OBJS];
+		u32 i;
+		int ret = 0;
+
+		if (copy_from_user(&args, argp, sizeof(args)))
+			return -EFAULT;
+		if (args.count == 0 || args.count > NTSYNC_MAX_OBJS)
+			return -EINVAL;
+		if (copy_from_user(fds, (void __user *)(uintptr_t)args.objs, sizeof(u32) * args.count))
+			return -EFAULT;
+
+		for (i = 0; i < args.count; i++) {
+			files[i] = fget(fds[i]);
+			if (!files[i] || files[i]->f_op != &ntsync_obj_fops) {
+				while (i > 0)
+					fput(files[--i]);
+				if (files[0] && files[0]->f_op == &ntsync_obj_fops)
+					fput(files[0]);
+				return -EBADF;
+			}
+			objs[i] = files[i]->private_data;
+		}
+
+		if (cmd == NTSYNC_IOC_WAIT_ANY)
+			ret = ntsync_wait_any(objs, args.count, (u32)current->pid, &args.index);
+		else {
+			ret = ntsync_wait_all(objs, args.count, (u32)current->pid);
+			args.index = 0;
+		}
+
+		for (i = 0; i < args.count; i++)
+			fput(files[i]);
+
+		if (ret == 0) {
+			if (copy_to_user(argp, &args, sizeof(args)))
+				return -EFAULT;
+		}
+		return ret;
+	}
+	default:
+		return -ENOTTY;
+	}
+}
+
+static int ntsync_open(struct inode *inode, struct file *file)
+{
+	return 0;
+}
+
+static int ntsync_release(struct inode *inode, struct file *file)
+{
+	return 0;
+}
+
+static const struct file_operations ntsync_fops = {
+	.owner          = THIS_MODULE,
+	.open           = ntsync_open,
+	.release        = ntsync_release,
+	.unlocked_ioctl = ntsync_ioctl,
+	.compat_ioctl   = compat_ptr_ioctl,
+};
+
+static struct miscdevice ntsync_misc = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name  = NTSYNC_NAME,
+	.fops  = &ntsync_fops,
+	.mode  = 0666,
+};
+
+static int __init ntsync_init(void)
+{
+	int ret = misc_register(&ntsync_misc);
+	if (ret) {
+		pr_err("ntsync: failed to register misc device (%d)\n", ret);
+		return ret;
+	}
+	pr_info("ntsync: NT synchronization primitive driver registered (/dev/ntsync)\n");
+	return 0;
+}
+
+static void __exit ntsync_exit(void)
+{
+	misc_deregister(&ntsync_misc);
+	pr_info("ntsync: unregistered (/dev/ntsync)\n");
+}
+
+module_init(ntsync_init);
+module_exit(ntsync_exit);
+
+MODULE_AUTHOR("Elizabeth Figura <zfigura@codeweavers.com>");
+MODULE_DESCRIPTION("NT synchronization primitive driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS_MISCDEV(MISC_DYNAMIC_MINOR);
-- 
