[Unit]
Description=Pull and verify the latest public Kiyan OS ISO release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=KIYAN_OUTPUT_DIR=/home/ubuntu/mac_shared
StateDirectory=kiyan-os-pull
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 /usr/local/libexec/kiyan-release-pull.py
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/mac_shared
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

