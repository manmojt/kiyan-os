[Unit]
Description=Recover Huawei I2C touchpad kernel modules
After=systemd-modules-load.service
ConditionPathExists=/usr/bin/modprobe

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/kiyan-touchpad-watchdog.sh
TimeoutStartSec=20s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=no
PrivateTmp=yes

