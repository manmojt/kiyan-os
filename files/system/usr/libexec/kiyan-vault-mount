#!/usr/bin/python3
"""Privileged, constrained mount helper used only by kiyan-vault."""
import os
import pathlib
import re
import shutil
import subprocess
import sys
import uuid


def main():
    if len(sys.argv) != 3 or sys.argv[2] not in ("bitlocker", "apfs"):
        raise RuntimeError("Usage: kiyan-vault-mount BLOCK_DEVICE bitlocker|apfs")
    device = pathlib.Path(sys.argv[1])
    if not device.is_block_device(): raise RuntimeError("The selected path is not a block device")
    uid = int(os.environ.get("PKEXEC_UID", "-1"))
    if uid < 1000: raise RuntimeError("Could not identify the desktop user")
    import pwd
    user = pwd.getpwuid(uid)
    label = re.sub(r"[^A-Za-z0-9_.-]", "_", device.name)[:48]
    mount_root = pathlib.Path("/run/kiyan-vault/mounts")
    mount_root.mkdir(mode=0o755, parents=True, exist_ok=True)
    target = mount_root / f"Kiyan-Vault-{label}-{uuid.uuid4().hex[:8]}"
    target.mkdir(mode=0o700, parents=True, exist_ok=False)
    os.chown(target, uid, user.pw_gid)
    try:
        secret = sys.stdin.readline().rstrip("\n")
        if not secret: raise RuntimeError("No volume password was supplied")
        if sys.argv[2] == "bitlocker":
            fusepoint = pathlib.Path("/run/kiyan-vault/dislocker") / str(uuid.uuid4())
            fusepoint.mkdir(mode=0o700, parents=True)
            method = "-p" if len(secret.replace("-", "")) == 48 else "-u"
            subprocess.run(["dislocker", "-V", str(device), method + secret, "--", str(fusepoint), "-o", "allow_other"], check=True)
            cleartext = fusepoint / "dislocker-file"
            subprocess.run(["mount", "-t", "ntfs3", "-o", f"uid={uid},gid={user.pw_gid},umask=0077", str(cleartext), str(target)], check=True)
        else:
            binary = shutil.which("apfs-fuse") or shutil.which("apfs_fuse")
            if not binary: raise RuntimeError("apfs-fuse is not installed")
            subprocess.run([binary, str(device), str(target), "-r", secret, "-o", "allow_other"], check=True)
        print(target)
        return 0
    except Exception:
        target.rmdir()
        raise


if __name__ == "__main__":
    try: raise SystemExit(main())
    except (OSError, subprocess.CalledProcessError, RuntimeError, ValueError) as exc:
        print(f"kiyan-vault-mount: {exc}", file=sys.stderr)
        raise SystemExit(1)
