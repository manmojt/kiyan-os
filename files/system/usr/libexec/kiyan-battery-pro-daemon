#!/usr/bin/python3
"""Apply supported sysfs charge caps and conservative battery power policies."""
import os
import pathlib
import json
import signal
import subprocess
import sys
import time

POWER = pathlib.Path("/sys/class/power_supply")
CONFIG = pathlib.Path("/etc/kiyan/battery-pro.conf")
running = True


def read(path, default=""):
    try: return path.read_text().strip()
    except OSError: return default


def on_battery():
    batteries = [p for p in POWER.glob("*") if read(p / "type") == "Battery"]
    return bool(batteries) and all(read(p / "status") != "Charging" for p in batteries)


def apply_limit():
    cap = 80
    try:
        for line in CONFIG.read_text().splitlines():
            if line.startswith("charge_limit="): cap = int(line.split("=", 1)[1])
    except (OSError, ValueError): pass
    if not 50 <= cap <= 100: cap = 80
    for battery in POWER.glob("*"):
        if read(battery / "type") != "Battery": continue
        for attr in ("charge_control_end_threshold", "charge_stop_threshold"):
            path = battery / attr
            if path.exists():
                try:
                    if os.access(path, os.W_OK): path.write_text(f"{cap}\n")
                except OSError: pass
                break


def set_power_profile(profile):
    subprocess.run(["powerprofilesctl", "set", profile], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def tune_dgpu(battery):
    # Runtime PM is enabled only for discrete PCI display devices while on battery.
    for dev in pathlib.Path("/sys/bus/pci/devices").glob("*"):
        if read(dev / "class").startswith("0x03") and read(dev / "boot_vga") == "0" and (dev / "power/control").exists():
            try:
                if battery:
                    save_power_value(dev / "power/control")
                    (dev / "power/control").write_text("auto\n")
                cold = dev / "d3cold_allowed"
                if battery and cold.exists():
                    save_power_value(cold)
                    cold.write_text("1\n")
            except OSError: pass


def tune_cpu(battery):
    # EPP favors efficient idle/deep states; kernel firmware retains C-state ownership.
    for path in pathlib.Path("/sys/devices/system/cpu").glob("cpu*/cpufreq/energy_performance_preference"):
        try:
            if battery:
                save_power_value(path)
                path.write_text("power\n")
        except OSError: pass


def save_power_value(path):
    state = pathlib.Path("/run/kiyan-battery-pro/power-originals.json")
    try: values = json.loads(state.read_text())
    except (OSError, json.JSONDecodeError): values = {}
    key = str(path)
    if key not in values:
        values[key] = read(path)
        state.write_text(json.dumps(values))


def restore_power_values():
    state = pathlib.Path("/run/kiyan-battery-pro/power-originals.json")
    try: values = json.loads(state.read_text())
    except (OSError, json.JSONDecodeError): values = {}
    for name, value in values.items():
        try: pathlib.Path(name).write_text(value + "\n")
        except OSError: pass
    state.unlink(missing_ok=True)


def battery_percent():
    values = []
    for battery in POWER.glob("*"):
        if read(battery / "type") == "Battery":
            try: values.append(int(read(battery / "capacity")))
            except ValueError: pass
    return min(values) if values else 100


def survival_mode(enabled):
    saved = pathlib.Path("/run/kiyan-battery-pro/brightness")
    if enabled:
        values = []
        for path in pathlib.Path("/sys/class/backlight").glob("*/brightness"):
            try:
                current = int(read(path, "0"))
                maximum = int(read(path.parent / "max_brightness", "0"))
                values.append((path, current, max(1, maximum // 4)))
            except ValueError: continue
        if values and not saved.exists():
            saved.write_text("\n".join(f"{path} {value}" for path, value, _target in values) + "\n")
        for path, current, target in values:
            if target < current:
                try: path.write_text(f"{target}\n")
                except OSError: pass
    elif saved.exists():
        for line in saved.read_text().splitlines():
            path, value = line.rsplit(" ", 1)
            try: pathlib.Path(path).write_text(value + "\n")
            except OSError: pass
        saved.unlink(missing_ok=True)


def set_limit(value):
    if not 50 <= value <= 100: raise ValueError("charge limit must be between 50 and 100")
    supported = 0
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(f"charge_limit={value}\n")
    for battery in POWER.glob("*"):
        if read(battery / "type") != "Battery": continue
        for attr in ("charge_control_end_threshold", "charge_stop_threshold"):
            path = battery / attr
            if path.exists():
                path.write_text(f"{value}\n")
                supported += 1
                break
    if not supported: raise RuntimeError("no writable charge limit is supported by this hardware")


def thaw_tracked():
    directory = pathlib.Path("/run/kiyan-battery-pro")
    state = directory / "frozen"
    if state.exists():
        for item in state.read_text().splitlines():
            try: os.kill(int(item), signal.SIGCONT)
            except (ProcessLookupError, ValueError): pass
        state.unlink(missing_ok=True)
    (directory / "idle").unlink(missing_ok=True)


def freeze_idle_apps():
    """Opt-in app nap for demonstrably idle sandboxed GUI apps only."""
    # Users opt in by creating this file; ordinary mode never suspends processes.
    if not pathlib.Path("/etc/kiyan/battery-pro-freeze-apps").exists():
        thaw_tracked()
        return
    now = time.time()
    tracking = pathlib.Path("/run/kiyan-battery-pro/idle")
    try: idle = {int(pid): (float(ts), int(io)) for pid, ts, io in (line.split() for line in tracking.read_text().splitlines())}
    except (OSError, ValueError): idle = {}
    candidates = []
    frozen_file = pathlib.Path("/run/kiyan-battery-pro/frozen")
    try: frozen = {int(pid) for pid in frozen_file.read_text().splitlines()}
    except (OSError, ValueError): frozen = set()
    for proc in pathlib.Path("/proc").glob("[0-9]*"):
        try:
            exe = os.readlink(proc / "exe")
            if not (exe.startswith("/app/") or "/flatpak/" in exe): continue
            # Never suspend a process with open sockets, audio devices, or recent disk I/O.
            fdlinks = [os.readlink(x) for x in (proc / "fd").iterdir()]
            if any(x.startswith("socket:") or "/snd/" in x or "audio" in x.lower() for x in fdlinks): continue
            fields = (proc / "io").read_text().splitlines()
            io = sum(int(line.split()[1]) for line in fields if line.startswith(("read_bytes:", "write_bytes:")))
            pid = int(proc.name)
            old = idle.get(pid)
            since = old[0] if old and old[1] == io else now
            if now - since >= 600:
                os.kill(pid, signal.SIGSTOP)
                frozen.add(pid)
            else:
                candidates.append(f"{pid} {since:.0f} {io}")
        except (OSError, ValueError, PermissionError): continue
    tracking.write_text("\n".join(candidates) + ("\n" if candidates else ""))
    frozen_file.write_text("\n".join(str(pid) for pid in sorted(frozen)) + ("\n" if frozen else ""))


def stop(_sig, _frame):
    global running
    running = False


def main():
    global running
    if len(sys.argv) == 3 and sys.argv[1] == "--set-limit":
        set_limit(int(sys.argv[2]))
        return
    if len(sys.argv) == 3 and sys.argv[1] == "--app-nap" and sys.argv[2] in ("enable", "disable"):
        marker = pathlib.Path("/etc/kiyan/battery-pro-freeze-apps")
        marker.parent.mkdir(parents=True, exist_ok=True)
        if sys.argv[2] == "enable": marker.touch(mode=0o600, exist_ok=True)
        else: marker.unlink(missing_ok=True)
        print(f"Battery Pro app nap: {sys.argv[2]}d")
        return
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    pathlib.Path("/run/kiyan-battery-pro").mkdir(mode=0o700, parents=True, exist_ok=True)
    apply_limit()
    previous = None
    while running:
        battery = on_battery()
        if battery != previous:
            if not battery: restore_power_values()
            set_power_profile("power-saver" if battery else "balanced")
            tune_dgpu(battery)
            tune_cpu(battery)
            previous = battery
        apply_limit()
        if battery and battery_percent() <= 5:
            set_power_profile("power-saver")
            survival_mode(True)
        else:
            survival_mode(False)
        if battery: freeze_idle_apps()
        else: thaw_tracked()
        time.sleep(30)
    thaw_tracked()
    survival_mode(False)
    restore_power_values()
    set_power_profile("balanced")


if __name__ == "__main__": main()
