#!/usr/bin/python3
"""VPN-aware, self-cleaning NetworkManager hotspot router service."""
import os
import pathlib
import signal
import subprocess
import sys
import time

STATE = pathlib.Path("/run/kiyan-netshare")
TABLE = "kiyan_netshare"
HOTSPOT = "Kiyan NetShare"
running = True
fallback_processes = []
fallback_iface = None


def run(args, check=True, capture=False):
    return subprocess.run(args, check=check, text=True, stdout=subprocess.PIPE if capture else subprocess.DEVNULL, stderr=subprocess.PIPE if capture else subprocess.DEVNULL)


def tunnel_ifaces():
    found = []
    for p in pathlib.Path("/sys/class/net").iterdir():
        name = p.name
        if (p / "tun_flags").exists() or name in ("tun0", "wg0", "ppp0") or name.startswith(("tun", "wg", "ppp", "vpn", "v2ray", "utun", "nordlynx", "mullvad", "tailscale", "proton")):
            if (p / "operstate").exists() and (p / "operstate").read_text().strip() != "down":
                found.append(name)
    # OpenVPN and other TUN-based clients can use arbitrary interface names.
    for line in pathlib.Path("/proc/net/dev").read_text().splitlines()[2:]:
        name = line.split(":", 1)[0].strip()
        if name.startswith(("tun", "tap")) and name not in found:
            found.append(name)
    return found


def wifi_iface():
    result = run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"], capture=True)
    for line in result.stdout.splitlines():
        fields = line.split(":")
        if len(fields) >= 4 and fields[1] == "wifi" and (fields[2] == "disconnected" or fields[3] == HOTSPOT):
            return fields[0]
    return None


def default_iface():
    result = run(["ip", "-4", "route", "show", "default"], capture=True, check=False)
    for token_i, token in enumerate(result.stdout.split()):
        if token == "dev" and token_i + 1 < len(result.stdout.split()):
            return result.stdout.split()[token_i + 1]
    return None


def nft_setup(tunnels, downstreams):
    run(["nft", "add", "table", "inet", TABLE], check=False)
    run(["nft", "add", "chain", "inet", TABLE, "forward", "{", "type", "filter", "hook", "forward", "priority", "-5", ";", "policy", "accept", ";", "}"], check=False)
    run(["nft", "add", "chain", "inet", TABLE, "postrouting", "{", "type", "nat", "hook", "postrouting", "priority", "srcnat", ";", "}"], check=False)
    run(["nft", "add", "chain", "inet", TABLE, "prerouting", "{", "type", "nat", "hook", "prerouting", "priority", "dstnat", ";", "}"], check=False)
    # Clear only this daemon's dedicated table before reinstalling its rules.
    run(["nft", "flush", "chain", "inet", TABLE, "forward"], check=False)
    run(["nft", "flush", "chain", "inet", TABLE, "postrouting"], check=False)
    run(["nft", "flush", "chain", "inet", TABLE, "prerouting"], check=False)
    # Match only downstream subnets: host forwarding and container networking stay untouched.
    for index, (iface, subnet) in enumerate(downstreams):
        for tunnel in tunnels:
            run(["nft", "add", "rule", "inet", TABLE, "forward", "iifname", iface, "oifname", tunnel, "accept"])
            run(["nft", "add", "rule", "inet", TABLE, "forward", "iifname", tunnel, "oifname", iface, "ct", "state", "established,related", "accept"])
            run(["nft", "add", "rule", "inet", TABLE, "postrouting", "ip", "saddr", subnet, "oifname", tunnel, "masquerade"])
        run(["nft", "add", "rule", "inet", TABLE, "forward", "iifname", iface, "drop"])
        run(["nft", "add", "rule", "inet", TABLE, "prerouting", "iifname", iface, "udp", "dport", "53", "redirect", "to", ":53"], check=False)
        run(["nft", "add", "rule", "inet", TABLE, "prerouting", "iifname", iface, "tcp", "dport", "53", "redirect", "to", ":53"], check=False)
        for tunnel in tunnels:
            run(["nft", "add", "rule", "inet", TABLE, "forward", "iifname", iface, "oifname", tunnel, "tcp", "flags", "syn", "tcp", "option", "maxseg", "size", "set", "1360"], check=False)
            run(["nft", "add", "rule", "inet", TABLE, "forward", "iifname", tunnel, "oifname", iface, "tcp", "flags", "syn", "tcp", "option", "maxseg", "size", "set", "1360"], check=False)
    # Normalize IPv4 TTL to 64 for downstream clients.
    run(["nft", "add", "chain", "inet", TABLE, "mangle_post", "{", "type", "filter", "hook", "postrouting", "priority", "mangle", ";", "}"], check=False)
    run(["nft", "flush", "chain", "inet", TABLE, "mangle_post"], check=False)
    for _iface, subnet in downstreams:
        for tunnel in tunnels:
            run(["nft", "add", "rule", "inet", TABLE, "mangle_post", "ip", "saddr", subnet, "oifname", tunnel, "ip", "ttl", "set", "64"], check=False)


def cleanup():
    stop_fallback()
    run(["nmcli", "connection", "down", HOTSPOT], check=False)
    run(["nmcli", "connection", "delete", HOTSPOT], check=False)
    result = run(["nmcli", "-t", "-f", "NAME", "connection", "show"], check=False, capture=True)
    for name in result.stdout.splitlines():
        if name.startswith("Kiyan NetShare LAN "):
            run(["nmcli", "connection", "down", name], check=False)
            run(["nmcli", "connection", "delete", name], check=False)
    run(["nft", "delete", "table", "inet", TABLE], check=False)
    ip_forward = STATE / "ip_forward.original"
    if ip_forward.exists():
        try: pathlib.Path("/proc/sys/net/ipv4/ip_forward").write_text(ip_forward.read_text())
        except OSError: pass
        ip_forward.unlink(missing_ok=True)
    STATE.joinpath("status").unlink(missing_ok=True)


def stop_fallback():
    global fallback_processes, fallback_iface
    for proc in fallback_processes:
        if proc.poll() is None:
            proc.terminate()
            try: proc.wait(timeout=3)
            except subprocess.TimeoutExpired: proc.kill()
    fallback_processes = []
    if fallback_iface:
        run(["ip", "addr", "del", "10.42.0.1/24", "dev", fallback_iface], check=False)
        fallback_iface = None


def start_fallback(wlan, password):
    """Use hostapd/dnsmasq if NetworkManager cannot create the AP profile."""
    global fallback_processes, fallback_iface
    run(["nmcli", "connection", "down", HOTSPOT], check=False)
    run(["ip", "link", "set", wlan, "up"])
    run(["ip", "addr", "add", "10.42.0.1/24", "dev", wlan], check=False)
    fallback_iface = wlan
    host_conf = STATE / "hostapd.conf"
    host_conf.write_text("\n".join((
        f"interface={wlan}", "driver=nl80211", "ssid=Kiyan-Share", "hw_mode=g", "channel=6",
        "wpa=2", f"wpa_passphrase={password}", "wpa_key_mgmt=WPA-PSK", "rsn_pairwise=CCMP", "",
    )))
    dns_conf = STATE / "dnsmasq.conf"
    dns_conf.write_text("\n".join((
        f"interface={wlan}", "bind-interfaces", "no-resolv", "server=127.0.0.53", "dhcp-authoritative",
        "dhcp-range=10.42.0.20,10.42.0.240,255.255.255.0,12h", "dhcp-option=3,10.42.0.1", "dhcp-option=6,10.42.0.1", "",
    )))
    host = subprocess.Popen(["hostapd", str(host_conf)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    dns = subprocess.Popen(["dnsmasq", "--no-daemon", "--conf-file=" + str(dns_conf), "--pid-file=" + str(STATE / "dnsmasq.pid")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    fallback_processes = [host, dns]
    time.sleep(2)
    if host.poll() is not None or dns.poll() is not None:
        cleanup()
        raise RuntimeError("hostapd/dnsmasq could not start the fallback hotspot")


def stop(_sig, _frame):
    global running
    running = False


def main():
    global running
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        while running:
            tunnels = tunnel_ifaces()
            wlan = wifi_iface()
            if not tunnels:
                cleanup()
                STATE.joinpath("status").write_text("No active VPN tunnel; router is stopped (kill switch active).\n")
            elif not wlan:
                cleanup()
                STATE.joinpath("status").write_text("VPN found, but no Wi-Fi adapter is available.\n")
            else:
                forward = pathlib.Path("/proc/sys/net/ipv4/ip_forward")
                if forward.exists() and forward.read_text().strip() != "1":
                    original = STATE / "ip_forward.original"
                    if not original.exists(): original.write_text(forward.read_text())
                    forward.write_text("1\n")
                password = STATE / "passphrase"
                if not password.exists():
                    password.parent.mkdir(parents=True, exist_ok=True)
                    password.write_text(os.urandom(12).hex()[:16] + "\n")
                    password.chmod(0o600)
                # NM shared mode supplies hotspot DHCP and DNS. The dedicated nft table
                # constrains forwarding to VPN interfaces, including the fail-closed case.
                exists = run(["nmcli", "-t", "-f", "NAME", "connection", "show"], capture=True).stdout.splitlines()
                if HOTSPOT not in exists:
                    run(["nmcli", "connection", "add", "type", "wifi", "ifname", wlan, "con-name", HOTSPOT, "autoconnect", "no", "ssid", "Kiyan-Share", "802-11-wireless.mode", "ap", "802-11-wireless.band", "bg", "ipv4.method", "shared", "ipv6.method", "disabled", "wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.psk", password.read_text().strip()])
                run(["nmcli", "connection", "modify", HOTSPOT, "connection.interface-name", wlan, "ipv4.method", "shared", "ipv4.addresses", "10.42.0.1/24", "ipv6.method", "disabled"], check=False)
                fallback_live = fallback_iface == wlan and bool(fallback_processes) and all(proc.poll() is None for proc in fallback_processes)
                if fallback_iface and not fallback_live:
                    stop_fallback()
                hotspot_up = False if fallback_live else run(["nmcli", "connection", "up", HOTSPOT], check=False).returncode == 0
                if not hotspot_up and not fallback_live:
                    start_fallback(wlan, password.read_text().strip())
                downstreams = [(wlan, "10.42.0.0/24")]
                default = default_iface()
                devs = run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device"], capture=True)
                for line in devs.stdout.splitlines():
                    fields = line.split(":")
                    if len(fields) < 3 or fields[1] != "ethernet" or fields[2] != "disconnected" or fields[0] == default:
                        continue
                    dev = fields[0]
                    name = "Kiyan NetShare LAN " + dev
                    active = run(["nmcli", "-t", "-f", "NAME", "connection", "show"], capture=True).stdout.splitlines()
                    if name not in active:
                        run(["nmcli", "connection", "add", "type", "ethernet", "ifname", dev, "con-name", name, "autoconnect", "no", "ipv4.method", "shared", "ipv4.addresses", "10.43.0.1/24", "ipv6.method", "disabled"], check=False)
                    if run(["nmcli", "-t", "-f", "NAME", "connection", "show", "--active"], capture=True).stdout.splitlines().count(name) == 0:
                        run(["nmcli", "connection", "up", name], check=False)
                    if run(["nmcli", "-t", "-f", "NAME", "connection", "show", "--active"], capture=True).stdout.splitlines().count(name):
                        downstreams.append((dev, "10.43.0.0/24"))
                # Rebuild routes/rules continuously so VPN loss closes client forwarding.
                nft_setup(tunnels, downstreams)
                STATE.joinpath("status").write_text(f"VPN tunnel(s): {', '.join(tunnels)}\nWi-Fi hotspot: Kiyan-Share ({'NetworkManager' if hotspot_up else 'hostapd/dnsmasq'})\nEthernet downstream(s): {', '.join(dev for dev, _net in downstreams[1:]) or 'none'}\nForwarding is restricted to active VPN tunnel(s).\n")
            for _ in range(5):
                if not running:
                    break
                time.sleep(1)
    finally:
        cleanup()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"kiyan-netshare: {exc}", file=sys.stderr)
        cleanup()
        raise SystemExit(1)
