[Desktop Entry]
Type=Service
Name=Kiyan Quick Look
MimeType=application/octet-stream;application/pdf;application/json;application/xml;image/*;audio/*;video/*;text/*;
Actions=kiyan-quicklook;
X-KDE-Priority=TopLevel

[Desktop Action kiyan-quicklook]
Name=Quick Look
Name[fa]=پیش‌نمایش سریع
Icon=document-preview
Exec=kiyan-quicklook %f
