#!/usr/bin/python3
"""Convert selected text between Persian and US English keyboard layouts."""
import argparse
import os
import sys
import time
sys.path.insert(0, "/usr/lib/kiyan")
from desktop import error, have, notify, run

# Standard Persian keyboard positions mapped to the corresponding US key positions.
EN = "qwertyuiop[]asdfghjkl;'zxcvbnm,./`"
FA = "ضصثقفغعهخحجچشسیبلاتنمکگظطزرذدئو.؟پ"
MAP = dict(zip(EN, FA))
MAP.update({v: k for k, v in zip(EN, FA)})
for upper, lower in zip(EN.upper(), EN):
    MAP[upper] = MAP.get(lower, upper)


def get_clipboard():
    if have("wl-paste") and os.environ.get("WAYLAND_DISPLAY"):
        return run(["wl-paste", "--no-newline"], check=False, capture=True).stdout
    if have("xclip") and os.environ.get("DISPLAY"):
        return run(["xclip", "-selection", "clipboard", "-o"], check=False, capture=True).stdout
    raise RuntimeError("Install wl-clipboard to convert selected text on Wayland")


def set_clipboard(value):
    if have("wl-copy") and os.environ.get("WAYLAND_DISPLAY"):
        run(["wl-copy", "--type", "text/plain;charset=utf-8"], input_text=value)
    elif have("xclip") and os.environ.get("DISPLAY"):
        run(["xclip", "-selection", "clipboard", "-i"], input_text=value)
    else:
        raise RuntimeError("No clipboard writer found")


def send_shortcut(key):
    # Linux input-event-codes: left Ctrl=29, C=46, V=47.
    code = {"c": "46", "v": "47"}[key]
    run(["ydotool", "key", "29:1", f"{code}:1", f"{code}:0", "29:0"])


def convert(value):
    persian = sum("\u0600" <= c <= "\u06ff" for c in value)
    latin = sum(c.isascii() and c.isalpha() for c in value)
    return "".join(MAP.get(c, c) for c in value), ("persian" if latin >= persian else "english")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--text", help="convert text directly instead of the current selection")
    parser.add_argument("--print", action="store_true", help="print converted text")
    args = parser.parse_args()
    if args.text is not None:
        source = args.text
    else:
        # Copy selection, convert, paste back, then restore the user's previous clipboard.
        if not have("ydotool"):
            raise RuntimeError("Install ydotool and enable its user service for selection hotkey conversion")
        previous = get_clipboard()
        send_shortcut("c"); time.sleep(0.18)
        source = get_clipboard()
        if not source:
            raise RuntimeError("Select text before invoking the keyboard layout converter")
    result, direction = convert(source)
    if args.print:
        sys.stdout.write(result)
    elif args.text is not None:
        set_clipboard(result)
        notify("Kiyan Typo Fixer", f"Converted text to {direction} keyboard layout")
    else:
        set_clipboard(result)
        send_shortcut("v")
        time.sleep(0.35)
        set_clipboard(previous)
        notify("Kiyan Typo Fixer", f"Converted selected text to {direction} layout")
    return 0

if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc: error("Kiyan Typo Fixer", str(exc)); raise SystemExit(1)
