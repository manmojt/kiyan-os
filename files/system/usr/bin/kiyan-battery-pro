#!/usr/bin/python3
"""Battery charge-limit and portable power controls for Kiyan OS."""
import argparse
import pathlib
import os
import subprocess
import sys

SYS = pathlib.Path("/sys/class/power_supply")


def thresholds():
    for device in SYS.glob("*"):
        if not (device / "type").exists() or (device / "type").read_text().strip() != "Battery":
            continue
        for attr in ("charge_control_end_threshold", "charge_stop_threshold"):
            path = device / attr
            if path.exists() and path.stat().st_mode & 0o222:
                yield path


def main():
    p = argparse.ArgumentParser(description="Kiyan battery charge and power management")
    sub = p.add_subparsers(dest="command", required=True)
    sub.add_parser("status", help="show battery status and supported charge limits")
    limit = sub.add_parser("limit", help="set supported battery charge cap (50–100%)")
    limit.add_argument("percent", type=int)
    nap = sub.add_parser("app-nap", help="control idle sandboxed app freezing")
    nap.add_argument("state", choices=("enable", "disable"))
    sub.add_parser("daemon", help=argparse.SUPPRESS)
    args = p.parse_args()
    if args.command == "daemon":
        return subprocess.call(["/usr/libexec/kiyan-battery-pro-daemon"])
    if args.command == "app-nap":
        if os.geteuid() != 0:
            return subprocess.call(["pkexec", "/usr/libexec/kiyan-battery-pro-daemon", "--app-nap", args.state])
        marker = pathlib.Path("/etc/kiyan/battery-pro-freeze-apps")
        marker.parent.mkdir(parents=True, exist_ok=True)
        if args.state == "enable": marker.touch(mode=0o600, exist_ok=True)
        else: marker.unlink(missing_ok=True)
        print(f"Battery Pro app nap: {args.state}d")
        return 0
    if args.command == "status":
        for device in SYS.glob("*"):
            if (device / "type").exists() and (device / "type").read_text().strip() == "Battery":
                capacity = (device / "capacity").read_text().strip() if (device / "capacity").exists() else "unknown"
                state = (device / "status").read_text().strip() if (device / "status").exists() else "unknown"
                print(f"{device.name}: {capacity}% ({state})")
                for attr in ("charge_control_end_threshold", "charge_stop_threshold"):
                    path = device / attr
                    if path.exists(): print(f"  {attr}: {path.read_text().strip()}%")
        return 0
    if not 50 <= args.percent <= 100:
        p.error("charge limit must be between 50 and 100 percent")
    if os.geteuid() != 0:
        return subprocess.call(["pkexec", "/usr/libexec/kiyan-battery-pro-daemon", "--set-limit", str(args.percent)])
    found = list(thresholds())
    if not found:
        p.error("this hardware exposes no writable Linux charge threshold")
    config = pathlib.Path("/etc/kiyan/battery-pro.conf")
    config.parent.mkdir(parents=True, exist_ok=True)
    config.write_text(f"charge_limit={args.percent}\n")
    for path in found:
        path.write_text(f"{args.percent}\n")
        print(f"{path.parent.name}: charge limit set to {args.percent}%")
    return 0


if __name__ == "__main__":
    try: raise SystemExit(main())
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"kiyan-battery-pro: {exc}", file=sys.stderr)
        raise SystemExit(1)
