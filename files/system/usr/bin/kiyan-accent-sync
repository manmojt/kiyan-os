#!/usr/bin/python3
"""Sample the current Plasma wallpaper and apply its dominant accent color."""
import pathlib
import re
import sys
sys.path.insert(0, "/usr/lib/kiyan")
from desktop import error, have, run, reload_plasma

CONFIG = pathlib.Path.home() / ".config"


def wallpaper_path():
    path = CONFIG / "plasma-org.kde.plasma.desktop-appletsrc"
    if not path.is_file(): return None
    text = path.read_text(errors="replace")
    # Plasma stores the selected wallpaper in a wallpaper plugin's Image key.
    candidates = re.findall(r"(?m)^Image=(.+)$", text)
    for item in reversed(candidates):
        value = item.strip().replace("\\\\", "\\")
        if value.startswith("file://"):
            from urllib.parse import unquote, urlparse
            value = unquote(urlparse(value).path)
        candidate = pathlib.Path(value).expanduser()
        if candidate.is_file(): return candidate
    return None


def accent_from(path):
    try:
        from PIL import Image
        image = Image.open(path).convert("RGB")
        image.thumbnail((80, 80))
        colors = image.quantize(colors=8, method=Image.Quantize.MEDIANCUT).convert("RGB")
        palette = colors.getcolors(6400) or []
        palette.sort(reverse=True)
        for _, color in palette:
            r, g, b = color
            if max(r, g, b) - min(r, g, b) >= 36 and max(r, g, b) >= 90:
                return f"{r},{g},{b}"
    except Exception:
        pass
    return "64,224,208"  # Persian Turquoise fallback


def main():
    if not have("kwriteconfig6"): raise RuntimeError("kwriteconfig6 is required")
    image = wallpaper_path()
    color = accent_from(image) if image else "64,224,208"
    run(["kwriteconfig6", "--file", "kdeglobals", "--group", "General", "--key", "AccentColor", color])
    reload_plasma()
    return 0

if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc: error("Kiyan Accent Sync", str(exc)); raise SystemExit(1)
