#!/usr/bin/python3
"""Small KDE front end for aria2 and yt-dlp."""
import pathlib, shutil, subprocess, sys

def ask(args):
    return subprocess.run(["kdialog", *args], text=True, capture_output=True)

def main():
    if not shutil.which("kdialog"):
        raise RuntimeError("kdialog is required")
    url = ask(["--title", "Kiyan Downloader", "--inputbox", "URL to download (web pages are inspected with yt-dlp):"])
    if url.returncode or not url.stdout.strip(): return 0
    target = ask(["--title", "Kiyan Downloader", "--getexistingdirectory", str(pathlib.Path.home() / "Downloads")])
    if target.returncode or not target.stdout.strip(): return 0
    url = url.stdout.strip(); dest = target.stdout.strip()
    media = False
    if shutil.which("yt-dlp"):
        sniff = subprocess.run(["yt-dlp", "--simulate", "--quiet", "--no-warnings", "--", url],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        media = sniff.returncode == 0
    if media:
        command = ["yt-dlp", "--no-playlist", "--output", str(pathlib.Path(dest) / "%(title)s.%(ext)s")]
        # yt-dlp delegates segmented media downloads to aria2 when available.
        # Fall back to yt-dlp's native downloader on images without aria2.
        if shutil.which("aria2c"):
            command += ["--downloader", "aria2c", "--downloader-args",
                        "aria2c:-c -x 32 -s 32 -k 1M"]
        subprocess.Popen(command + ["--", url], start_new_session=True)
    else:
        if not shutil.which("aria2c"):
            raise RuntimeError("aria2c is required for file downloads")
        subprocess.Popen(["aria2c", "--continue=true", "--max-connection-per-server=32",
                          "--split=32", "--min-split-size=1M", "--max-concurrent-downloads=5",
                          "--dir", dest, "--", url], start_new_session=True)
    return 0

if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc:
        subprocess.run(["kdialog", "--error", str(exc)], check=False)
        raise SystemExit(1)
