#!/usr/bin/python3
"""Clean clipboard rich text and tracking URLs; optionally monitor clipboard changes."""
import argparse
import hashlib
import os
import sys
import time
sys.path.insert(0, "/usr/lib/kiyan")
from clipboard import clean_text
from desktop import error, have, notify, run


def read_clipboard():
    if have("wl-paste") and os.environ.get("WAYLAND_DISPLAY"):
        result = run(["wl-paste", "--no-newline", "--type", "text"], check=False, capture=True)
        return result.stdout if result.returncode == 0 else ""
    if have("xclip") and os.environ.get("DISPLAY"):
        return run(["xclip", "-selection", "clipboard", "-o"], check=False, capture=True).stdout
    raise RuntimeError("No clipboard reader found (install wl-clipboard for Wayland)")


def write_clipboard(text):
    if have("wl-copy") and os.environ.get("WAYLAND_DISPLAY"):
        run(["wl-copy", "--type", "text/plain;charset=utf-8"], input_text=text)
    elif have("xclip") and os.environ.get("DISPLAY"):
        run(["xclip", "-selection", "clipboard", "-i"], input_text=text)
    else:
        raise RuntimeError("No clipboard writer found (install wl-clipboard for Wayland)")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--watch", action="store_true", help="clean clipboard whenever its text changes")
    args = parser.parse_args()
    if not args.watch:
        before = read_clipboard(); after = clean_text(before)
        if before != after:
            write_clipboard(after); notify("Kiyan Purepaste", "Clipboard cleaned")
        else: notify("Kiyan Purepaste", "Clipboard is already plain and clean")
        return 0
    last = None
    while True:
        try:
            value = read_clipboard()
            digest = hashlib.sha256(value.encode("utf-8", "replace")).digest()
            if value and digest != last:
                last = digest
                cleaned = clean_text(value)
                if cleaned != value:
                    write_clipboard(cleaned)
                    last = hashlib.sha256(cleaned.encode()).digest()
        except (RuntimeError, OSError):
            pass
        time.sleep(0.7)

if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc: error("Kiyan Purepaste", str(exc)); raise SystemExit(1)
