#!/usr/bin/python3
"""Fetch the opted-in, TLS-verified speed-dial feed at most once per day."""
import json, pathlib, ssl, urllib.error, urllib.request
HOME = pathlib.Path.home(); CFG = HOME / ".config/kiyan/browser.json"
FEED = HOME / ".cache/kiyan/browser/feed.json"
DEFAULT = {"smart_shopping_opt_in": False, "feed_url": "https://92.5.113.35/kiyan/v1/tiles.json", "search_url": ""}
def main():
    CFG.parent.mkdir(parents=True, exist_ok=True)
    if not CFG.exists(): CFG.write_text(json.dumps(DEFAULT, indent=2) + "\n")
    cfg = json.loads(CFG.read_text())
    if not cfg.get("smart_shopping_opt_in", False): return 0
    url = cfg.get("feed_url", "")
    if not url.startswith("https://92.5.113.35/"):
        raise RuntimeError("Feed must use the configured Kiyan HTTPS host")
    req = urllib.request.Request(url, headers={"Accept": "application/json", "User-Agent": "KiyanBrowser/1"})
    with urllib.request.urlopen(req, context=ssl.create_default_context(), timeout=15) as res:
        if res.status != 200 or res.headers.get_content_type() != "application/json": raise RuntimeError("Invalid feed response")
        raw = res.read(262145)
        if len(raw) > 262144: raise RuntimeError("Feed exceeds 256 KiB")
        payload = json.loads(raw)
    if not isinstance(payload, dict) or not isinstance(payload.get("tiles"), list) or len(payload["tiles"]) > 24:
        raise RuntimeError("Invalid feed schema")
    for tile in payload["tiles"]:
        if not isinstance(tile, dict) or not all(isinstance(tile.get(k), str) for k in ("title", "url")) or not tile["url"].startswith("https://"):
            raise RuntimeError("Unsafe speed-dial tile")
    FEED.parent.mkdir(parents=True, exist_ok=True)
    tmp = FEED.with_suffix(".tmp"); tmp.write_text(json.dumps(payload, ensure_ascii=False)); tmp.replace(FEED)
    return 0
if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as e:
        print(f"kiyan-browser-sync: {e}")
        raise SystemExit(1)
