#!/usr/bin/python3
"""Bilingual two-step launcher for eight Kiyan OS settings categories."""
import sys
sys.path.insert(0, "/usr/lib/kiyan")
from desktop import error, have, run, notify, undo_snapshot

CATEGORIES = {
 "personalization": ("Personalization / شخصی‌سازی", [("macos", "macOS Mode"), ("windows11", "Windows 11 Mode"), ("linux-pro", "Linux Pro Mode"), ("obsidian", "Obsidian Aurora Dark"), ("crystal", "Crystal Light")]),
 "devices": ("Devices / دستگاه‌ها", [("mouse", "Mouse & Touchpad"), ("display", "Display Configuration")]),
 "network": ("Network / شبکه", [("network", "Network Connections")]),
 "sound": ("Sound / صدا", [("sound", "Audio Settings")]),
 "appearance": ("Appearance / ظاهر", [("appearance", "Theme and Colors")]),
 "keyboard": ("Keyboard / صفحه‌کلید", [("keyboard", "Keyboard Layouts"), ("typo", "Convert Selected Text")]),
 "privacy": ("Privacy / حریم خصوصی", [("clipboard", "Clipboard Cleaner"), ("undo", "Undo Last Change")]),
 "system": ("System / سیستم", [("system", "System Information"), ("forcequit", "Force Quit Application")]),
}


def launch(action):
    if action in ("macos", "windows11", "linux-pro"):
        run(["kiyan-switcher", "persona", action])
    elif action in ("obsidian", "crystal"):
        run(["kiyan-switcher", "color", action])
    elif action == "undo":
        undo_snapshot(); notify("Kiyan Settings", "Last change restored")
    elif action == "clipboard": run(["kiyan-purepaste"])
    elif action == "typo": run(["kiyan-typo-fixer"])
    elif action == "forcequit": run(["kiyan-forcequit"])
    else:
        modules = {"mouse": "kcm_touchpad", "display": "kcm_kscreen", "network": "kcm_networkmanagement",
                   "sound": "kcm_pulseaudio", "appearance": "kcm_lookandfeel", "keyboard": "kcm_keyboard",
                   "system": "kcm_about-distro"}
        run(["kcmshell6", modules[action]])


def main():
    if not have("kdialog"): raise RuntimeError("kdialog is required for the Settings Hub")
    top = []
    for key, (label, _) in CATEGORIES.items(): top.extend([key, label])
    top.extend(["search", "Search / جستجو"])
    selected = run(["kdialog", "--title", "Kiyan Settings / تنظیمات کیان", "--menu",
                    "Choose a category / یک دسته را انتخاب کنید", *top], check=False, capture=True)
    if selected.returncode: return 0
    if selected.stdout.strip() == "search":
        query = run(["kdialog", "--title", "Kiyan Settings Search / جستجوی تنظیمات",
                     "--inputbox", "Search settings in English or Persian / جستجو به فارسی یا انگلیسی", ""],
                    check=False, capture=True)
        if query.returncode or not query.stdout.strip(): return 0
        needle = query.stdout.strip().casefold()
        matches = [(key, f"{label} — {title}") for key, (label, entries) in CATEGORIES.items()
                   for action, title in entries if needle in label.casefold() or needle in title.casefold()]
        if not matches: raise RuntimeError("No matching setting / تنظیمی پیدا نشد")
        menu = []
        for key, title in matches: menu.extend([key, title])
        selected = run(["kdialog", "--title", "Kiyan Settings", "--menu", "Choose a setting", *menu],
                       check=False, capture=True)
        if selected.returncode: return 0
        launch(selected.stdout.strip())
        return 0
    actions = CATEGORIES[selected.stdout.strip()][1]
    menu = []
    for key, title in actions: menu.extend([key, title])
    chosen = run(["kdialog", "--title", "Kiyan Settings", "--menu", "Choose a setting", *menu], check=False, capture=True)
    if chosen.returncode: return 0
    launch(chosen.stdout.strip())
    return 0

if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc: error("Kiyan Settings", str(exc)); raise SystemExit(1)
