#!/usr/bin/python3
"""Rollback and boot deployment selector for the OSTree-backed system."""
import shutil, subprocess
def main():
    if not shutil.which("bootc") and not shutil.which("rpm-ostree"):
        raise RuntimeError("Kiyan OS deployment tools are unavailable")
    if subprocess.run(["kdialog", "--yesno", "Switch the default boot OS to the previous deployment? The choice takes effect after restart and can be switched back here." ]).returncode:
        return 0
    if shutil.which("bootc"):
        return subprocess.call(["pkexec", "bootc", "rollback"])
    return subprocess.call(["pkexec", "rpm-ostree", "rollback"])
if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc:
        subprocess.run(["kdialog", "--error", str(exc)]); raise SystemExit(1)
