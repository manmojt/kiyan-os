#!/usr/bin/python3
"""Offline conversion front end for ffmpeg and heif-convert."""
import pathlib, shutil, subprocess, sys

def dialog(*args): return subprocess.run(["kdialog", *args], text=True, capture_output=True)
def main():
    if len(sys.argv) > 1:
        sources = [pathlib.Path(p) for p in sys.argv[1:]]
    else:
        picked = dialog("--getopenfilename", str(pathlib.Path.home()), "*|All files")
        if picked.returncode: return 0
        sources = [pathlib.Path(picked.stdout.strip())]
    mode = dialog("--title", "Kiyan Converter", "--menu", "Choose output format",
                  "mp4", "Video (H.264/MP4)", "mp3", "Audio (MP3)", "pdf", "Document (PDF)",
                  "jpg", "Image (JPEG)")
    if mode.returncode: return 0
    fmt = mode.stdout.strip()
    for src in sources:
        if not src.is_file(): continue
        dest = src.with_suffix("." + fmt)
        suffix = src.suffix.lower()
        if fmt == "pdf":
            if suffix not in (".doc", ".docx", ".odt", ".rtf", ".txt", ".html", ".htm", ".xls", ".xlsx", ".ppt", ".pptx", ".odp", ".ods"):
                raise RuntimeError(f"PDF export is not supported for {src.name}")
            if not shutil.which("libreoffice"):
                raise RuntimeError("LibreOffice is required for document-to-PDF conversion")
            cmd = ["libreoffice", "--headless", "--convert-to", "pdf", "--outdir", str(src.parent), str(src)]
        elif fmt == "jpg" and suffix in (".heic", ".heif"):
            if not shutil.which("heif-convert"):
                raise RuntimeError("libheif-tools is required for HEIC conversion")
            cmd = ["heif-convert", str(src), str(dest)]
        elif fmt in ("mp4", "mp3", "jpg"):
            if not shutil.which("ffmpeg"):
                raise RuntimeError("ffmpeg is required for media conversion")
            if fmt == "mp4":
                cmd = ["ffmpeg", "-nostdin", "-y", "-i", str(src), "-c:v", "libx264", "-c:a", "aac", str(dest)]
            elif fmt == "mp3":
                cmd = ["ffmpeg", "-nostdin", "-y", "-i", str(src), "-vn", "-codec:a", "libmp3lame", "-q:a", "2", str(dest)]
            else:
                cmd = ["ffmpeg", "-nostdin", "-y", "-i", str(src), "-frames:v", "1", str(dest)]
        else:
            raise RuntimeError(f"Unsupported output format: {fmt}")
        result = subprocess.run(cmd, check=False)
        if result.returncode: raise RuntimeError(f"Conversion failed for {src.name}")
    dialog("--msgbox", "Conversion finished.")
    return 0
if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc:
        subprocess.run(["kdialog", "--error", str(exc)], check=False); raise SystemExit(1)
