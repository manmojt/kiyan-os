#!/usr/bin/python3
"""Select a user-owned process to kill, freeze, or resume."""
import argparse
import os
import pathlib
import signal
import sys
sys.path.insert(0, "/usr/lib/kiyan")
from desktop import error, have, run, notify


def processes():
    result = []
    for entry in pathlib.Path("/proc").iterdir():
        if not entry.name.isdigit(): continue
        pid = int(entry.name)
        if pid == os.getpid(): continue
        try:
            status = (entry / "status").read_text()
            uid = int(next(line.split()[1] for line in status.splitlines() if line.startswith("Uid:")))
            if uid != os.getuid(): continue
            name = (entry / "comm").read_text().strip()
            cmd = (entry / "cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace").strip()
            result.append((pid, name, cmd[:100]))
        except (OSError, StopIteration, ValueError):
            continue
    return sorted(result, key=lambda item: (item[1].lower(), item[0]))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", nargs="?", choices=("kill", "freeze", "resume"), default="choose")
    parser.add_argument("pid", nargs="?", type=int)
    args = parser.parse_args()
    action = args.action
    processes_now = processes()
    if action == "choose":
        if not have("kdialog"): raise RuntimeError("kdialog is required for the process overlay")
        options = []
        for pid, name, cmd in processes_now:
            options.extend([str(pid), f"{name} — {cmd or name}"])
        if not options: raise RuntimeError("No user-owned processes are available")
        selected = run(["kdialog", "--title", "Kiyan Force Quit", "--menu", "Choose an application", *options], check=False, capture=True)
        if selected.returncode: return 0
        pid = int(selected.stdout.strip())
        choice = run(["kdialog", "--title", "Kiyan Force Quit", "--menu", "Choose an action",
                      "kill", "Force quit", "freeze", "Freeze", "resume", "Resume"], check=False, capture=True)
        if choice.returncode: return 0
        action = choice.stdout.strip()
    else:
        pid = args.pid
    if not pid or pid <= 1: raise RuntimeError("A valid user process ID is required")
    owned = {item[0] for item in processes()}
    if pid not in owned: raise RuntimeError("Refusing to signal a process not owned by this user")
    sig = {"kill": signal.SIGKILL, "freeze": signal.SIGSTOP, "resume": signal.SIGCONT}[action]
    os.kill(pid, sig)
    notify("Kiyan Force Quit", f"{action.title()} sent to process {pid}")
    return 0

if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc: error("Kiyan Force Quit", str(exc)); raise SystemExit(1)
