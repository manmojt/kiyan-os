#!/usr/bin/python3
"""Extract archives and repair legacy Persian CP1256 member names safely."""
import pathlib, shutil, subprocess, sys, tarfile, zipfile

def run(*args): return subprocess.run(args, check=False).returncode
def repair(root):
    for p in sorted(root.rglob("*"), key=lambda p: len(p.parts), reverse=True):
        name = p.name
        try:
            raw = name.encode("cp437")
            fixed = raw.decode("cp1256")
        except (UnicodeError, LookupError): continue
        if fixed != name and not (p.parent / fixed).exists(): p.rename(p.parent / fixed)
def main():
    archives = [pathlib.Path(p) for p in sys.argv[1:]]
    if not archives:
        r = subprocess.run(["kdialog", "--getopenfilename", str(pathlib.Path.home()), "*.{zip,7z,rar,tar,gz,bz2,xz}"] , text=True, capture_output=True)
        if r.returncode: return 0
        archives = [pathlib.Path(r.stdout.strip())]
    for archive in archives:
        out = archive.parent / archive.stem
        out.mkdir(exist_ok=True)
        if zipfile.is_zipfile(archive):
            with zipfile.ZipFile(archive) as zf:
                for item in zf.infolist():
                    # Extract via the standard library after rejecting traversal.
                    dest = (out / item.filename).resolve()
                    if out.resolve() not in dest.parents and dest != out.resolve(): raise RuntimeError("Unsafe archive path")
                zf.extractall(out)
        elif archive.suffix.lower() == ".rar" and shutil.which("unrar"):
            if run("unrar", "x", "-o+", str(archive), str(out) + "/"): raise RuntimeError(f"Could not extract {archive}")
        elif archive.name.lower().endswith((".tar", ".tar.gz", ".tgz", ".tar.bz2", ".tbz2", ".tar.xz", ".txz")):
            with tarfile.open(archive, "r:*") as tf: tf.extractall(out, filter="data")
        elif shutil.which("7z"):
            if run("7z", "x", "-y", f"-o{out}", str(archive)): raise RuntimeError(f"Could not extract {archive}")
        elif shutil.which("tar"):
            if run("tar", "-xf", str(archive), "-C", str(out)): raise RuntimeError(f"Could not extract {archive}")
        else: raise RuntimeError("Install 7z or tar to extract this archive")
        repair(out)
    return 0
if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc:
        subprocess.run(["kdialog", "--error", str(exc)], check=False); raise SystemExit(1)
