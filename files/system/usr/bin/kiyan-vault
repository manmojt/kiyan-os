#!/usr/bin/python3
"""Discover BitLocker/APFS block volumes and mount them with a KDE prompt."""
import json
import os
import pathlib
import subprocess
import sys


def main():
    devices = json.loads(subprocess.check_output(["lsblk", "-J", "-p", "-o", "NAME,TYPE,FSTYPE,LABEL,UUID"], text=True))["blockdevices"]
    candidates = []
    def visit(items):
        for item in items:
            fs = (item.get("fstype") or "").lower()
            if item.get("type") == "part" and ("bitlocker" in fs or fs == "apfs"):
                label = item.get("label") or pathlib.Path(item["name"]).name
                candidates.append((item["name"], fs, label))
            visit(item.get("children") or [])
    visit(devices)
    if not candidates:
        subprocess.run(["kdialog", "--sorry", "No BitLocker or APFS partitions were found."], check=False)
        return 1
    choices = []
    for device, fs, label in candidates:
        choices.extend((device, f"{label} — {fs.upper()}"))
    selected = subprocess.run(["kdialog", "--title", "Kiyan Vault", "--menu", "Choose a supported encrypted volume:", *choices], text=True, capture_output=True)
    if selected.returncode or not selected.stdout.strip(): return 0
    device = selected.stdout.strip()
    fs = next(fs for path, fs, _label in candidates if path == device)
    password = ""
    if "bitlocker" in fs or fs == "apfs":
        entered = subprocess.run(["kdialog", "--title", "Kiyan Vault", "--password", "Enter the BitLocker or APFS password (or BitLocker recovery key):"], text=True, capture_output=True)
        if entered.returncode: return 0
        password = entered.stdout.rstrip("\n")
        if not password: raise RuntimeError("A volume password is required")
    helper = ["pkexec", "/usr/libexec/kiyan-vault-mount", device, "bitlocker" if "bitlocker" in fs else "apfs"]
    result = subprocess.run(helper, input=password + "\n", text=True, capture_output=True)
    if result.returncode:
        message = result.stderr.strip() or result.stdout.strip() or "Mount failed"
        subprocess.run(["kdialog", "--title", "Kiyan Vault", "--error", message], check=False)
        return result.returncode
    mountpoint = result.stdout.strip().splitlines()[-1]
    subprocess.run(["kdialog", "--title", "Kiyan Vault", "--passivepopup", f"Volume mounted at {mountpoint}", "5"], check=False)
    subprocess.run(["xdg-open", mountpoint], check=False)
    return 0


if __name__ == "__main__":
    try: raise SystemExit(main())
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError, RuntimeError) as exc:
        print(f"kiyan-vault: {exc}", file=sys.stderr)
        raise SystemExit(1)
