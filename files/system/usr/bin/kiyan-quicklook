#!/usr/bin/python3
"""Preview a selected file from Dolphin using its native viewer."""
import mimetypes
import pathlib
import sys
import xml.etree.ElementTree as ET
sys.path.insert(0, "/usr/lib/kiyan")
from desktop import atomic_write, error, have, run, snapshot


def install_shortcut():
    """Bind Space to this file action in Dolphin's KF6 action collection."""
    path = pathlib.Path.home() / ".local/share/kxmlgui6/dolphin/dolphinui.rc"
    if path.is_file():
        try: root = ET.parse(path).getroot()
        except ET.ParseError as exc: raise RuntimeError(f"Dolphin shortcut file is malformed: {exc}")
    else:
        root = ET.Element("gui", {"name": "dolphin", "version": "1"})
    action_name = "servicemenu_kiyan-quicklook.desktop::kiyan-quicklook"
    node = root.find(".//ActionProperties[@scheme='Default']/Action[@name='" + action_name + "']")
    if node is not None and node.get("shortcut") == "Space": return
    snapshot()
    properties = root.find("ActionProperties[@scheme='Default']")
    if properties is None:
        properties = ET.SubElement(root, "ActionProperties", {"scheme": "Default"})
    if node is None:
        node = ET.SubElement(properties, "Action", {"name": action_name})
    node.set("shortcut", "Space")
    path.parent.mkdir(parents=True, exist_ok=True)
    ET.indent(root, space="  ")
    atomic_write(path, ET.tostring(root, encoding="utf-8", xml_declaration=True) + b"\n")


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "--install-shortcut":
        install_shortcut()
        return 0
    if len(sys.argv) != 2:
        raise RuntimeError("Usage: kiyan-quicklook FILE | --install-shortcut")
    path = pathlib.Path(sys.argv[1]).expanduser().resolve(strict=True)
    if not path.is_file():
        raise RuntimeError("Quick Look supports files, not directories")
    mime, _ = mimetypes.guess_type(path.name)
    if mime and mime.startswith("image/"):
        app = "gwenview" if have("gwenview") else "xdg-open"
    elif mime == "application/pdf":
        app = "okular" if have("okular") else "xdg-open"
    elif mime and mime.startswith("video/"):
        app = "mpv" if have("mpv") else "xdg-open"
    elif mime and mime.startswith("audio/"):
        app = "mpv" if have("mpv") else "xdg-open"
    elif mime and (mime.startswith("text/") or mime in ("application/json", "application/xml")):
        app = "kdialog"
        if have("kdialog"):
            run([app, "--title", f"Quick Look — {path.name}", "--textbox", str(path), "700", "500"], check=False)
            return 0
        app = "xdg-open"
    else:
        app = "xdg-open"
    if not have(app):
        raise RuntimeError(f"No preview application found for {mime or 'this file type'}")
    run([app, str(path)], check=False)
    return 0

if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc: error("Kiyan Quick Look", str(exc)); raise SystemExit(1)
