#!/usr/bin/python3
"""Share selected files over the local network using a short-lived QR link."""
import http.server
import html
import pathlib
import secrets
import subprocess
import sys
import urllib.parse


class Handler(http.server.BaseHTTPRequestHandler):
    files = []
    token = ""
    def do_GET(self):
        path = urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)
        prefix = "/" + self.token + "/"
        if not path.startswith(prefix): self.send_error(404); return
        name = path[len(prefix):]
        if not name:
            links = "".join(f'<li><a href="{prefix}{urllib.parse.quote(item.name, safe="")}">{html.escape(item.name)}</a> ({item.stat().st_size} bytes)</li>' for item in self.files)
            body = ("<!doctype html><meta charset=utf-8><title>Kiyan AirShare</title>"
                    "<h1>Shared files</h1><ul>" + links + "</ul>").encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
            return
        match = next((p for p in self.files if p.name == name), None)
        if match is None or not match.is_file(): self.send_error(404); return
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Content-Length", str(match.stat().st_size))
        self.send_header("Content-Disposition", "attachment; filename*=UTF-8''" + urllib.parse.quote(match.name))
        self.end_headers()
        with match.open("rb") as source:
            while chunk := source.read(1024 * 1024): self.wfile.write(chunk)
    def log_message(self, _format, *_args): pass


def main():
    files = [pathlib.Path(arg).expanduser().resolve(strict=True) for arg in sys.argv[1:]]
    if not files or any(not p.is_file() for p in files):
        raise RuntimeError("Select one or more regular files in Dolphin")
    token = secrets.token_urlsafe(18)
    Handler.files, Handler.token = files, token
    with http.server.ThreadingHTTPServer(("0.0.0.0", 0), Handler) as server:
        server.daemon_threads = True
        port = server.server_address[1]
        # Show all private LAN addresses so the QR still works across multi-homed systems.
        output = subprocess.run(["ip", "-o", "-4", "addr", "show", "scope", "global"], text=True, capture_output=True, check=True).stdout
        addresses = sorted({line.split()[3].split("/", 1)[0] for line in output.splitlines() if len(line.split()) >= 4})
        addresses.sort(key=lambda ip: (0 if ip == "10.42.0.1" else 1 if ip == "10.43.0.1" else 2, ip))
        if not addresses: raise RuntimeError("No local IPv4 address is available")
        urls = [f"http://{addr}:{port}/{token}/" for addr in addresses]
        subprocess.run(["qrencode", "-t", "ANSIUTF8", urls[0]], check=True)
        print("Scan this QR code on your phone. Keep this window open while downloading.")
        if len(urls) > 1: print("Other LAN link(s):\n" + "\n".join(urls[1:]))
        print("Press Ctrl+C to stop sharing.", flush=True)
        server.serve_forever()
    return 0


if __name__ == "__main__":
    try: raise SystemExit(main())
    except (OSError, RuntimeError) as exc:
        print(f"kiyan-airshare: {exc}", file=sys.stderr)
        raise SystemExit(1)
