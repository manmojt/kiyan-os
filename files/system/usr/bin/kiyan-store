#!/usr/bin/python3
"""Explicit GUI installer for Flatpak, Distrobox, KPK and Windows apps."""
import json, os, pathlib, shutil, subprocess, sys, tarfile, tempfile
CA = "/usr/share/kiyan/kiyan-os-root-ca.pem"
def dialog(*a): return subprocess.run(["kdialog", *a], text=True, capture_output=True)
def confirm(text): return dialog("--yesno", text).returncode == 0
def signed_install(path):
    if not shutil.which("openssl"): raise RuntimeError("OpenSSL is required")
    with tempfile.TemporaryDirectory(prefix="kiyan-kpk-") as td:
        with tarfile.open(path, "r:*") as tf:
            for m in tf.getmembers():
                dest = pathlib.PurePosixPath(m.name)
                if dest.is_absolute() or ".." in dest.parts or not (m.isfile() or m.isdir()):
                    raise RuntimeError("Package contains an unsafe path or file type")
            tf.extractall(td, filter="data")
        root = pathlib.Path(td); manifest = root / "manifest.json"; sig = root / "manifest.p7s"
        if not manifest.is_file() or not sig.is_file(): raise RuntimeError("KPK needs manifest.json and manifest.p7s")
        check = subprocess.run(["openssl", "cms", "-verify", "-binary", "-inform", "DER", "-in", str(sig),
                                "-content", str(manifest), "-CAfile", CA, "-purpose", "any", "-out", os.devnull], capture_output=True)
        if check.returncode: raise RuntimeError("Kiyan package signature verification failed")
        meta = json.loads(manifest.read_text()); name = meta.get("name", "")
        if not name or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-" for c in name):
            raise RuntimeError("Invalid package name in signed manifest")
        for rel, expected in meta.get("files", {}).items():
            f = (root / "payload" / rel).resolve()
            if root / "payload" not in f.parents or not f.is_file(): raise RuntimeError("Invalid payload entry")
            import hashlib
            if hashlib.sha256(f.read_bytes()).hexdigest() != expected: raise RuntimeError(f"Payload hash mismatch: {rel}")
        target = pathlib.Path("/var/lib/kiyan/packages") / name
        if not confirm(f"Install verified Kiyan package {name} to {target}? This installs data without running scripts."): return
        subprocess.run(["pkexec", "/usr/bin/install", "-d", "-m", "0755", str(target)], check=True)
        executables = set(meta.get("executables", []))
        if not executables.issubset(set(meta.get("files", {}))): raise RuntimeError("Executable list must reference signed files")
        for rel in meta.get("files", {}):
            dest = target / rel
            mode = "0755" if rel in executables else "0644"
            subprocess.run(["pkexec", "/usr/bin/install", "-D", "-m", mode, str(root / "payload" / rel), str(dest)], check=True)
def main():
    r = dialog("--menu", "Choose installation source", "flatpak", "Flatpak application ID", "distrobox", "Package in a Distrobox",
               "kpk", "Signed Kiyan package (.kpk)", "windows", "Windows .exe/.msi")
    if r.returncode: return 0
    choice = r.stdout.strip()
    if choice == "kpk":
        p = dialog("--getopenfilename", str(pathlib.Path.home()), "*.kpk|Kiyan packages")
        if not p.returncode: signed_install(p.stdout.strip())
    elif choice in ("flatpak", "distrobox"):
        p = dialog("--inputbox", "Enter the application ID or package name:")
        if p.returncode or not p.stdout.strip(): return 0
        package = p.stdout.strip()
        if any(c.isspace() for c in package): raise RuntimeError("Enter one package identifier")
        if choice == "flatpak":
            if confirm(f"Install {package} from the configured Flatpak remotes?"):
                return subprocess.call(["flatpak", "install", "--user", "-y", "flathub", package])
        else:
            boxes = subprocess.run(["distrobox", "list", "--name-only"], text=True, capture_output=True)
            box = dialog("--combobox", "Choose a Distrobox:", *boxes.stdout.splitlines())
            if not box.returncode and confirm(f"Install {package} inside Distrobox {box.stdout.strip()}?"):
                return subprocess.call(["distrobox", "enter", box.stdout.strip(), "--", "sudo", "dnf", "install", "-y", package])
    else:
        p = dialog("--getopenfilename", str(pathlib.Path.home()), "*.{exe,msi}|Windows installers")
        if p.returncode: return 0
        installer = pathlib.Path(p.stdout.strip())
        if not confirm(f"Run this Windows installer through WinBoat/Proton?\n{installer}"): return 0
        if shutil.which("winboat"): return subprocess.call(["winboat", "install", str(installer)])
        proton = shutil.which("proton")
        steam = pathlib.Path.home() / ".steam/steam"
        if not proton:
            candidates = sorted((steam / "steamapps/common").glob("Proton*/proton")) if (steam / "steamapps/common").exists() else []
            if candidates: proton = str(candidates[-1])
        if not proton: raise RuntimeError("WinBoat or Proton is not installed. Install Proton from Steam first.")
        env = os.environ.copy(); env.setdefault("STEAM_COMPAT_CLIENT_INSTALL_PATH", str(steam))
        env.setdefault("STEAM_COMPAT_DATA_PATH", str(pathlib.Path.home()/".local/share/kiyan/proton-prefix"))
        if pathlib.Path("/dev/ntsync").exists(): env["PROTON_USE_NTSYNC"] = "1"
        return subprocess.call([proton, "run", str(installer)], env=env)
    return 0
if __name__ == "__main__":
    try: raise SystemExit(main())
    except Exception as exc:
        subprocess.run(["kdialog", "--error", str(exc)], check=False); raise SystemExit(1)
