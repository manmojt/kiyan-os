#!/usr/bin/env bash
# ==============================================================================
# KIAN-OS v3: Atomic Btrfs APT Pre/Post Transaction Hook
# Path: scripts/btrfs-apt-hook
# Description: DPkg hook executed before and after APT transactions to create
#              atomic, tamper-evident Btrfs snapshot pairs of @rootfs.
# ==============================================================================
set -euo pipefail

SNAP_DIR="${KIAN_SNAPSHOTS_DIR:-/.snapshots}"
STATE_FILE="${KIAN_APT_STATE_FILE:-/run/kian_apt_snapshot.state}"
TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")
KERNEL_VER=$(uname -r)

# Check if the root filesystem is Btrfs
is_btrfs_root() {
    # If explicitly bypassed or mocked
    if [[ "${KIAN_MOCK_BTRFS:-0}" == "1" ]]; then
        return 0
    fi
    # Check if / is btrfs
    if command -v btrfs &>/dev/null; then
        if btrfs subvolume show / &>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# Ensure snapshot directory exists
init_env() {
    if [[ ! -d "${SNAP_DIR}" ]]; then
        mkdir -p "${SNAP_DIR}"
        chmod 0750 "${SNAP_DIR}"
    fi
}

# Resolve parent command invoking apt/dpkg
get_invoking_cmd() {
    local cmd="apt-transaction"
    if [[ -n "${PPID:-}" ]] && command -v ps &>/dev/null; then
        cmd=$(ps -o args= -p "$PPID" 2>/dev/null || echo "apt-transaction")
    fi
    echo "${cmd}" | tr '"' "'"
}

case "${1:-}" in
    pre)
        if ! is_btrfs_root; then
            # Silent non-error exit when not running on Btrfs
            exit 0
        fi
        init_env

        # Determine next sequential snapshot ID
        LAST_ID=$(find "${SNAP_DIR}" -mindepth 1 -maxdepth 1 -type d -name "snap_*" 2>/dev/null | \
            awk -F'snap_' '{print $2}' | awk -F'_' '{print $1}' | sort -n | tail -n 1 || true)
        
        if [[ -z "${LAST_ID}" || ! "${LAST_ID}" =~ ^[0-9]+$ ]]; then
            NEXT_ID=1
        else
            NEXT_ID=$((LAST_ID + 1))
        fi

        SNAP_NAME="snap_${NEXT_ID}_pre"
        TARGET_PATH="${SNAP_DIR}/${SNAP_NAME}"

        echo ":: [KIAN-OS] Creating pre-transaction atomic Btrfs snapshot #${NEXT_ID}..."
        if [[ "${KIAN_MOCK_BTRFS:-0}" == "1" ]]; then
            mkdir -p "${TARGET_PATH}"
        else
            btrfs subvolume snapshot / "${TARGET_PATH}" >/dev/null
        fi

        APT_CMD=$(get_invoking_cmd)

        cat <<EOF > "${TARGET_PATH}/.kian_snapshot_meta.json"
{
  "id": ${NEXT_ID},
  "type": "pre",
  "name": "${SNAP_NAME}",
  "timestamp": "${TIMESTAMP}",
  "kernel": "${KERNEL_VER}",
  "trigger": "apt-pre-invoke",
  "command": "${APT_CMD}"
}
EOF
        if [[ "${KIAN_MOCK_BTRFS:-0}" != "1" ]]; then
            btrfs property set -ts "${TARGET_PATH}" ro true 2>/dev/null || true
        fi

        # Save ID to state file for post-invoke pairing
        mkdir -p "$(dirname "${STATE_FILE}")"
        echo "${NEXT_ID}" > "${STATE_FILE}"
        ;;

    post)
        if ! is_btrfs_root; then
            exit 0
        fi

        if [[ ! -f "${STATE_FILE}" ]]; then
            exit 0
        fi

        CURRENT_ID=$(cat "${STATE_FILE}")
        rm -f "${STATE_FILE}"

        if [[ -z "${CURRENT_ID}" || ! "${CURRENT_ID}" =~ ^[0-9]+$ ]]; then
            exit 0
        fi

        init_env
        SNAP_NAME="snap_${CURRENT_ID}_post"
        TARGET_PATH="${SNAP_DIR}/${SNAP_NAME}"

        echo ":: [KIAN-OS] Creating post-transaction atomic Btrfs snapshot #${CURRENT_ID}..."
        if [[ "${KIAN_MOCK_BTRFS:-0}" == "1" ]]; then
            mkdir -p "${TARGET_PATH}"
        else
            btrfs subvolume snapshot / "${TARGET_PATH}" >/dev/null
        fi

        cat <<EOF > "${TARGET_PATH}/.kian_snapshot_meta.json"
{
  "id": ${CURRENT_ID},
  "type": "post",
  "name": "${SNAP_NAME}",
  "timestamp": "${TIMESTAMP}",
  "kernel": "${KERNEL_VER}",
  "trigger": "apt-post-invoke",
  "paired_pre": "snap_${CURRENT_ID}_pre"
}
EOF
        if [[ "${KIAN_MOCK_BTRFS:-0}" != "1" ]]; then
            btrfs property set -ts "${TARGET_PATH}" ro true 2>/dev/null || true
        fi

        # Dynamically trigger GRUB snapshot list update if hook is present, or fallback to update-grub
        if [[ -x /usr/lib/kian/update-grub-snapshots ]]; then
            /usr/lib/kian/update-grub-snapshots &>/dev/null &
        elif command -v update-grub &>/dev/null; then
            update-grub &>/dev/null &
        fi
        ;;

    --help|-h|help)
        echo "KIAN-OS v3 Btrfs APT Transaction Hook"
        echo "Usage: $0 {pre|post}"
        exit 0
        ;;

    *)
        echo "Usage: $0 {pre|post}" >&2
        exit 1
        ;;
esac

exit 0
