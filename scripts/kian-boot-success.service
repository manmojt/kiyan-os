[Unit]
Description=KIAN-OS v3 Boot Watchdog Confirmation Service
Documentation=man:grub-editenv(1)
DefaultDependencies=no
After=graphical.target multi-user.target sddm.service
ConditionPathExists=/boot/grub/grubenv

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/bin/grub-editenv /boot/grub/grubenv set bootcount=0 && /usr/bin/grub-editenv /boot/grub/grubenv set boot_counter=0 2>/dev/null || true'
ExecStartPost=/usr/bin/logger -t kian-watchdog "KIAN-OS v3 Wayland session verified healthy. Watchdog boot counters reset to 0."
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
