#!/usr/bin/env bash
# ==============================================================================
# KIAN-OS v3: Btrfs Atomic Snapshot & Rollback Engine
# Path: scripts/kian-rollback
# Description: CLI engine for managing Btrfs rootfs snapshots, ephemeral boots,
#              and atomic rollback operations across the flat subvolume layout.
# ==============================================================================
set -euo pipefail

SNAP_DIR="${KIAN_SNAPSHOTS_DIR:-/.snapshots}"
BTRFS_MNT="${KIAN_BTRFS_MNT:-/mnt/.kian_btrfs_top}"

# Colors for CLI Output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

log_info()  { echo -e "${GREEN}:: [INFO]${NC} ${1}"; }
log_warn()  { echo -e "${YELLOW}:: [WARN]${NC} ${1}"; }
log_error() { echo -e "${RED}:: [ERROR]${NC} ${1}" >&2; }
log_step()  { echo -e "${CYAN}:: [STEP]${NC} ${1}"; }

# Ensure Root Privileges for privileged subvolume operations
require_root() {
    if [[ "${KIAN_TEST_MODE:-0}" == "1" ]]; then
        return 0
    fi
    if [[ $EUID -ne 0 ]]; then
        log_error "This operation requires root privileges. Please run with sudo."
        exit 1
    fi
}

# Verify that the target directory is on a Btrfs filesystem
check_btrfs() {
    local target="${1:-/}"
    if ! btrfs subvolume show "$target" &>/dev/null; then
        # Check if running under ephemeral overlayfs
        if grep -qs " /mnt/.ro_snapshot " /proc/mounts; then
            return 0
        fi
        log_error "Target '${target}' is not on a valid Btrfs subvolume."
        return 1
    fi
    return 0
}

# Mount Top-Level Btrfs Subvolume (subvolid=5) to manipulate sibling subvolumes
mount_top_level() {
    mkdir -p "${BTRFS_MNT}"

    if [[ "${KIAN_TEST_MODE:-0}" == "1" ]]; then
        return 0
    fi

    local root_dev=""
    # First check standard root mount
    root_dev=$(findmnt -n -o SOURCE / 2>/dev/null || true)

    # If root is an overlayfs (ephemeral snapshot boot), find underlying snapshot device
    if [[ "$root_dev" == "overlay" || -z "$root_dev" ]]; then
        root_dev=$(awk '$2 == "/mnt/.ro_snapshot" {print $1}' /proc/mounts || true)
    fi

    # Fallback to grub/fstab if still empty
    if [[ -z "$root_dev" ]]; then
        root_dev=$(awk '$2 == "/" && $3 == "btrfs" {print $1}' /etc/fstab 2>/dev/null || true)
    fi

    if [[ -z "$root_dev" ]]; then
        log_error "Unable to resolve underlying Btrfs root device."
        exit 1
    fi

    if ! mountpoint -q "${BTRFS_MNT}"; then
        mount -o subvolid=5 "${root_dev}" "${BTRFS_MNT}" || {
            log_error "Failed to mount Btrfs top-level filesystem (subvolid=5) from ${root_dev}."
            exit 1
        }
    fi
}

cleanup_mounts() {
    if [[ "${KIAN_TEST_MODE:-0}" == "1" ]]; then
        return 0
    fi
    if mountpoint -q "${BTRFS_MNT}" 2>/dev/null; then
        umount "${BTRFS_MNT}" 2>/dev/null || true
    fi
    if [[ -d "${BTRFS_MNT}" ]]; then
        rmdir "${BTRFS_MNT}" 2>/dev/null || true
    fi
}
trap cleanup_mounts EXIT

# ==============================================================================
# Command: list
# ==============================================================================
cmd_list() {
    echo -e "${BOLD}====================================================================================================${NC}"
    echo -e "${BOLD}${CYAN}KIAN-OS v3 Btrfs Snapshots Repository${NC}"
    echo -e "${BOLD}====================================================================================================${NC}"
    printf "${BOLD}%-6s  %-24s  %-10s  %-20s  %-20s  %s${NC}\n" "ID" "NAME" "TYPE" "DATE / TIME" "KERNEL" "TRIGGER"
    echo "----------------------------------------------------------------------------------------------------"

    if [[ ! -d "${SNAP_DIR}" ]]; then
        echo "No snapshots directory found at ${SNAP_DIR}."
        return 0
    fi

    local count=0
    # Search all snapshot subdirectories
    while IFS= read -r meta; do
        [[ -f "$meta" ]] || continue
        local id name snap_type ts kern trig
        id=$(grep -o '"id": *[0-9]*' "$meta" | cut -d: -f2 | tr -d ' ' || echo "-")
        if [[ -z "$id" || "$id" == "-" ]]; then
            id=$(basename "$(dirname "$meta")" | awk -F_ '{print $2}' || echo "-")
        fi
        name=$(grep -o '"name": *"[^"]*"' "$meta" | cut -d'"' -f4 || echo "-")
        snap_type=$(grep -o '"type": *"[^"]*"' "$meta" | cut -d'"' -f4 || echo "manual")
        ts=$(grep -o '"timestamp": *"[^"]*"' "$meta" | cut -d'"' -f4 || echo "-")
        kern=$(grep -o '"kernel": *"[^"]*"' "$meta" | cut -d'"' -f4 || echo "-")
        trig=$(grep -o '"trigger": *"[^"]*"' "$meta" | cut -d'"' -f4 || echo "-")

        local color="${NC}"
        case "$snap_type" in
            pre)    color="${YELLOW}" ;;
            post)   color="${GREEN}" ;;
            manual) color="${BLUE}" ;;
            boot)   color="${CYAN}" ;;
        esac

        printf "%-6s  %-24s  ${color}%-10s${NC}  %-20s  %-20s  %s\n" \
            "$id" "$name" "$snap_type" "$ts" "$kern" "$trig"
        count=$((count + 1))
    done < <(find "${SNAP_DIR}" -mindepth 1 -maxdepth 2 -name ".kian_snapshot_meta.json" 2>/dev/null | sort -V)

    if [[ $count -eq 0 ]]; then
        echo "No registered Kian snapshots found in ${SNAP_DIR}."
    fi
    echo "===================================================================================================="
    echo "Total snapshots: ${count}"
}

# ==============================================================================
# Command: create [label]
# ==============================================================================
cmd_create() {
    require_root
    check_btrfs "/"

    local label="${1:-manual}"
    # Sanitize label (alphanumeric and dashes/underscores only)
    label=$(echo "$label" | tr -cd '[:alnum:]_-')
    if [[ -z "$label" ]]; then
        label="manual"
    fi

    mkdir -p "${SNAP_DIR}"

    # Determine next available snapshot ID
    local last_id
    last_id=$(find "${SNAP_DIR}" -mindepth 1 -maxdepth 1 -type d -name "snap_*" 2>/dev/null | \
        awk -F'snap_' '{print $2}' | awk -F'_' '{print $1}' | sort -n | tail -n 1 || true)
    
    local next_id=1
    if [[ -n "${last_id}" && "${last_id}" =~ ^[0-9]+$ ]]; then
        next_id=$((last_id + 1))
    fi

    local snap_name="snap_${next_id}_${label}"
    local target_path="${SNAP_DIR}/${snap_name}"

    log_step "Creating atomic read-only Btrfs snapshot #${next_id} ('${label}')..."
    btrfs subvolume snapshot / "${target_path}" >/dev/null

    local timestamp
    timestamp=$(date +"%Y-%m-%d %H:%M:%S")
    local kernel_ver
    kernel_ver=$(uname -r)

    cat <<EOF > "${target_path}/.kian_snapshot_meta.json"
{
  "id": ${next_id},
  "type": "manual",
  "name": "${snap_name}",
  "label": "${label}",
  "timestamp": "${timestamp}",
  "kernel": "${kernel_ver}",
  "trigger": "kian-rollback-cli"
}
EOF
    btrfs property set -ts "${target_path}" ro true 2>/dev/null || true

    log_info "Snapshot created successfully at: ${target_path}"
    
    # Refresh GRUB dynamic snapshots menu if present
    if [[ -x /usr/lib/kian/update-grub-snapshots ]]; then
        /usr/lib/kian/update-grub-snapshots &>/dev/null &
    elif command -v update-grub &>/dev/null; then
        update-grub &>/dev/null &
    fi
}

# ==============================================================================
# Command: apply <snapshot_id_or_name>
# ==============================================================================
cmd_apply() {
    require_root
    local target_input="${1:-}"

    if [[ -z "${target_input}" ]]; then
        log_error "Snapshot ID or snapshot directory name must be provided."
        echo "Usage: kian-rollback apply <snapshot_id | snapshot_name>" >&2
        exit 1
    fi

    mount_top_level

    # Resolve target snapshot path
    local target_snap=""
    if [[ -d "${BTRFS_MNT}/@snapshots/${target_input}" ]]; then
        target_snap="${target_input}"
    else
        # Try matching by ID (e.g., "5" -> "snap_5_...")
        local match
        match=$(find "${BTRFS_MNT}/@snapshots" -mindepth 1 -maxdepth 1 -type d -name "snap_${target_input}_*" 2>/dev/null | head -n 1 || true)
        if [[ -n "${match}" ]]; then
            target_snap=$(basename "${match}")
        fi
    fi

    if [[ -z "${target_snap}" || ! -d "${BTRFS_MNT}/@snapshots/${target_snap}" ]]; then
        log_error "Snapshot '${target_input}' not found under @snapshots subvolume."
        exit 1
    fi

    local snap_source="${BTRFS_MNT}/@snapshots/${target_snap}"
    log_step "Initiating Atomic System Rollback to snapshot: ${target_snap}..."

    # Step 1: Create candidate writable root subvolume in staging location
    local timestamp
    timestamp="$(date +%Y%m%d_%H%M%S)"
    local candidate_name="@rootfs.candidate_${timestamp}"
    log_info "Cloning candidate root subvolume '${candidate_name}' from snapshot '${target_snap}'..."
    btrfs subvolume snapshot "${snap_source}" "${BTRFS_MNT}/${candidate_name}"

    # Step 2: Verify candidate subvolume was created successfully
    if [[ ! -d "${BTRFS_MNT}/${candidate_name}" ]]; then
        log_error "Failed to create candidate root subvolume '${candidate_name}'."
        exit 1
    fi

    # Step 3: Identify subvolume ID of candidate and update default subvolume
    local candidate_id
    candidate_id=$(btrfs subvolume list "${BTRFS_MNT}" 2>/dev/null | grep -E "path ${candidate_name}$" | awk '{print $2}' || true)
    if [[ -n "${candidate_id}" ]]; then
        log_info "Staging default Btrfs subvolume ID to ${candidate_id} (${candidate_name})..."
        btrfs subvolume set-default "${candidate_id}" "${BTRFS_MNT}" 2>/dev/null || true
    fi

    # Step 4: Perform atomic subvolume rename swap
    local backup_name="@rootfs.broken_${timestamp}"
    if [[ -d "${BTRFS_MNT}/@rootfs" ]]; then
        log_info "Preserving current root subvolume as: ${backup_name}..."
        mv "${BTRFS_MNT}/@rootfs" "${BTRFS_MNT}/${backup_name}"
    fi

    log_info "Promoting candidate subvolume to active '@rootfs'..."
    mv "${BTRFS_MNT}/${candidate_name}" "${BTRFS_MNT}/@rootfs"

    # Step 5: Finalize default subvolume to promoted @rootfs
    local root_id
    root_id=$(btrfs subvolume list "${BTRFS_MNT}" 2>/dev/null | grep -E "path @rootfs$" | awk '{print $2}' || true)
    if [[ -n "${root_id}" ]]; then
        log_info "Setting default Btrfs subvolume ID to ${root_id} (@rootfs)..."
        btrfs subvolume set-default "${root_id}" "${BTRFS_MNT}" 2>/dev/null || true
    fi

    # Dynamically trigger GRUB snapshot list update
    if [[ -x /usr/lib/kian/update-grub-snapshots ]]; then
        /usr/lib/kian/update-grub-snapshots &>/dev/null &
    elif command -v update-grub &>/dev/null; then
        update-grub &>/dev/null &
    fi

    log_step "System Rollback Completed Successfully!"
    log_info "Previous system state archived at: ${backup_name}"
    log_info "Target state restored from: ${target_snap}"
    echo -e "\n${BOLD}${GREEN}>> Please reboot your system now to boot into the restored rootfs. <<${NC}\n"
}

# ==============================================================================
# Command: delete <snapshot_id_or_name>
# ==============================================================================
cmd_delete() {
    require_root
    local target_input="${1:-}"

    if [[ -z "${target_input}" ]]; then
        log_error "Snapshot ID or snapshot directory name must be provided."
        echo "Usage: kian-rollback delete <snapshot_id | snapshot_name>" >&2
        exit 1
    fi

    local target_path=""
    if [[ -d "${SNAP_DIR}/${target_input}" ]]; then
        target_path="${SNAP_DIR}/${target_input}"
    else
        local match
        match=$(find "${SNAP_DIR}" -mindepth 1 -maxdepth 1 -type d -name "snap_${target_input}_*" 2>/dev/null | head -n 1 || true)
        if [[ -n "${match}" ]]; then
            target_path="${match}"
        fi
    fi

    if [[ -z "${target_path}" || ! -d "${target_path}" ]]; then
        log_error "Snapshot '${target_input}' not found."
        exit 1
    fi

    log_step "Deleting snapshot subvolume: $(basename "${target_path}")..."
    btrfs subvolume delete "${target_path}"
    log_info "Snapshot deleted."
}

# ==============================================================================
# Command: status
# ==============================================================================
cmd_status() {
    echo -e "${BOLD}${CYAN}KIAN-OS v3 Btrfs Resilience & Storage Status${NC}"
    echo "================================================================================"

    local root_fs
    root_fs=$(findmnt -n -o FSTYPE / 2>/dev/null || echo "unknown")
    local root_opts
    root_opts=$(findmnt -n -o OPTIONS / 2>/dev/null || echo "unknown")
    local root_src
    root_src=$(findmnt -n -o SOURCE / 2>/dev/null || echo "unknown")

    echo "Filesystem Type: ${root_fs}"
    echo "Root Device:     ${root_src}"
    echo "Mount Options:   ${root_opts}"

    if [[ "$root_fs" == "btrfs" ]]; then
        echo "--------------------------------------------------------------------------------"
        btrfs subvolume show / 2>/dev/null || true
        echo "--------------------------------------------------------------------------------"
        echo "Btrfs Free Space Summary:"
        btrfs filesystem usage / 2>/dev/null || btrfs filesystem df / 2>/dev/null || df -h /
    elif grep -qs " /mnt/.ro_snapshot " /proc/mounts; then
        echo -e "${YELLOW}>> NOTICE: Operating in Ephemeral OverlayFS mode over read-only snapshot. <<${NC}"
    fi
    echo "================================================================================"
}

# ==============================================================================
# CLI Dispatcher
# ==============================================================================
show_help() {
    cat <<EOF
KIAN-OS v3 Btrfs Atomic Snapshot & Rollback Engine
Usage: kian-rollback <COMMAND> [OPTIONS]

Commands:
  list                 List all available Btrfs snapshots and metadata
  create [label]       Create an atomic read-only snapshot of current @rootfs
  apply <id | name>    Atomically roll back @rootfs to the specified snapshot
  delete <id | name>   Delete a specified snapshot subvolume
  status               Display current Btrfs filesystem and subvolume health
  help                 Display this help message

Examples:
  sudo kian-rollback list
  sudo kian-rollback create before_upgrade
  sudo kian-rollback apply 3
  sudo kian-rollback apply snap_3_pre
  sudo kian-rollback status
EOF
}

case "${1:-help}" in
    list)
        cmd_list
        ;;
    create)
        shift
        cmd_create "${1:-manual}"
        ;;
    apply)
        shift
        cmd_apply "${1:-}"
        ;;
    delete|remove|rm)
        shift
        cmd_delete "${1:-}"
        ;;
    status)
        cmd_status
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        log_error "Unknown command: ${1}"
        show_help
        exit 1
        ;;
esac
